---
import { cn } from "@/lib/utils";

interface Props {
  name: string;
  color: string;
}

const { name, color } = Astro.props;
---

<span
  class:list={[cn("inline-flex items-center rounded-md px-2 py-0.5 text-xs font-medium text-white")]}
  style={`background-color: ${color}`}
>
  {name}
</span>
