---
import { cn } from "@/lib/utils";

interface Props {
  name: string;
  color: string;
  description?: string | null;
}

const { name, color, description } = Astro.props;
const trimmed = description?.trim() ?? "";
const note = trimmed.length > 0 ? trimmed : null;

const chipClass = cn("inline-flex items-center rounded-md px-2 py-0.5 text-xs font-medium text-white");
---

{
  note ? (
    <button type="button" class="group relative inline-flex max-w-full cursor-help border-0 bg-transparent p-0">
      <span class:list={[chipClass]} style={`background-color: ${color}`}>
        {name}
      </span>
      <span
        role="tooltip"
        class:list={[
          cn(
            "pointer-events-none invisible absolute top-full left-1/2 z-30 mt-1.5 w-max max-w-64 -translate-x-1/2 rounded-md",
            "bg-slate-950/95 px-2.5 py-1.5 text-center text-xs font-normal text-pretty text-blue-50 opacity-0 shadow-lg",
            "ring-1 ring-white/15 transition-opacity",
            "group-hover:visible group-hover:opacity-100 group-focus-visible:visible group-focus-visible:opacity-100",
          ),
        ]}
      >
        {note}
      </span>
    </button>
  ) : (
    <span class:list={[chipClass]} style={`background-color: ${color}`}>
      {name}
    </span>
  )
}
