---
import RunPreviewCard from "@/components/runs/RunPreviewCard.astro";
import { canOpenClanShowcaseRun, type ArchivedRunListItem, type RunListItem } from "@/lib/services/runs";

interface Props {
  incoming: RunListItem[];
  recent: ArchivedRunListItem[];
  historyHref: string;
  loadError?: string | null;
  viewerId: string | null;
  viewerIsAdmin: boolean;
  viewerIsClanMember: boolean;
  viewerConfirmedRunIds: ReadonlySet<string>;
}

const {
  incoming,
  recent,
  historyHref,
  loadError = null,
  viewerId,
  viewerIsAdmin,
  viewerIsClanMember,
  viewerConfirmedRunIds,
} = Astro.props;

function runHref(run: RunListItem | ArchivedRunListItem): string | null {
  return canOpenClanShowcaseRun(run, {
    id: viewerId,
    isAdmin: viewerIsAdmin,
    isClanMember: viewerIsClanMember,
    confirmedRunIds: viewerConfirmedRunIds,
  })
    ? `/runs/${run.id}`
    : null;
}
---

{
  loadError ? (
    <p class="mb-8 text-sm text-blue-100/60">{loadError}</p>
  ) : (
    <>
      <section class="mb-8">
        <h2 class="mb-4 text-2xl font-bold text-white">
          Incoming <span class="text-purple-300">Runs</span>
        </h2>
        {incoming.length === 0 ? (
          <p class="text-sm text-blue-100/60">No incoming clan runs.</p>
        ) : (
          <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            {incoming.map((run) => (
              <RunPreviewCard run={run} href={runHref(run)} />
            ))}
          </div>
        )}
      </section>

      <section class="mb-8">
        <div class="mb-4 flex items-end justify-between gap-4">
          <h2 class="text-2xl font-bold text-white">
            Recent <span class="text-purple-300">Runs</span>
          </h2>
          <a href={historyHref} class="text-sm text-blue-100/60 transition-colors hover:text-purple-200">
            View all →
          </a>
        </div>
        {recent.length === 0 ? (
          <p class="text-sm text-blue-100/60">No recent clan runs.</p>
        ) : (
          <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            {recent.map((run) => (
              <RunPreviewCard run={run} href={runHref(run)} />
            ))}
          </div>
        )}
      </section>
    </>
  )
}
