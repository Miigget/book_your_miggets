---
import NicknameLink from "@/components/NicknameLink.astro";
import { formatStart } from "@/lib/format-date";
import { formatJoinMode, type ArchivedRunListItem, type RunListItem } from "@/lib/services/runs";

interface Props {
  run: RunListItem | ArchivedRunListItem;
  /** Omit to link to `/runs/{id}`. Pass `null` when the viewer cannot open archived detail. */
  href?: string | null;
}

const { run, href: hrefProp } = Astro.props;
const href = hrefProp === undefined ? `/runs/${run.id}` : hrefProp;
const isArchived = run.lifecyclePhase === "archived";
---

<div
  class="flex h-full flex-col rounded-xl border border-white/10 bg-white/5 p-5 backdrop-blur-xl transition-colors hover:border-white/20 hover:bg-white/10"
>
  <div class="mb-3 flex items-start justify-between gap-3">
    <div class="min-w-0">
      <h3 class="truncate text-lg font-bold text-white">
        {
          href ? (
            <a href={href} class="transition-colors hover:text-purple-100 hover:underline">
              {run.displayTitle}
            </a>
          ) : (
            run.displayTitle
          )
        }
      </h3>
      <p class="text-sm text-blue-100/60">
        by <NicknameLink userId={run.organizerId} nickname={run.organizerNickname} />
      </p>
    </div>
    {
      run.lifecyclePhase === "in_progress" && (
        <span class="shrink-0 text-sm font-medium text-amber-200">In progress</span>
      )
    }
    {isArchived && <span class="shrink-0 text-sm font-medium text-blue-100/70">Archived</span>}
  </div>
  <div class="mb-3 grid flex-1 grid-cols-2 gap-2 text-sm text-blue-100/60">
    <div>
      Filled:{" "}
      <span class="text-blue-100/90">
        {run.confirmedCount}/{run.maxParticipants}
      </span>
    </div>
    <div>
      Join: <span class="text-blue-100/90">{formatJoinMode(run.joinMode)}</span>
    </div>
    {
      run.map ? (
        <div class="col-span-2">
          Map:{" "}
          <span class="text-blue-100/90">
            {run.map.name}
            <span class="text-blue-100/50">
              {" "}
              · {run.map.difficulty} · {run.map.points} pts
            </span>
          </span>
        </div>
      ) : run.mapCategory ? (
        <div class="col-span-2">
          Category: <span class="text-blue-100/90">{run.mapCategory}</span>
        </div>
      ) : null
    }
  </div>
  <time class="mt-auto border-t border-white/10 pt-3 text-xs text-blue-100/60" datetime={run.startsAt}>
    {formatStart(run.startsAt, Astro.locals.timeZone)}
  </time>
</div>
