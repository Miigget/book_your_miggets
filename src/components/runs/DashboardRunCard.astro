---
import RunMapsSummary from "@/components/runs/RunMapsSummary.astro";
import RunOrganizerByline from "@/components/runs/RunOrganizerByline.astro";
import { formatStart } from "@/lib/format-date";
import {
  formatJoinMode,
  formatVisibility,
  type ArchivedRunListItem,
  type OrganizerRunListItem,
  type RunListItem,
} from "@/lib/services/runs";

interface Props {
  run: RunListItem | ArchivedRunListItem | OrganizerRunListItem;
  showEdit?: boolean;
}

const { run, showEdit = false } = Astro.props;
const pendingCount = "pendingCount" in run ? run.pendingCount : null;
const isArchived = run.lifecyclePhase === "archived";
const showCompleted = Boolean(run.completedAt) && !isArchived;
---

<div
  class="group relative overflow-hidden rounded-xl border border-white/10 bg-white/5 px-5 py-4 transition-colors hover:border-white/20 hover:bg-white/10"
>
  <div class="flex min-w-0 flex-col gap-1 sm:flex-row sm:items-start sm:justify-between">
    <div class="min-w-0">
      <h3 class="min-w-0 text-lg font-semibold break-all text-white">
        <a
          href={`/runs/${run.id}`}
          class="group-hover:text-purple-100 group-hover:underline after:absolute after:inset-0 after:z-[1] after:rounded-xl after:content-['']"
        >
          {run.displayTitle}
        </a>
        {showCompleted && <span class="ml-2 text-sm font-medium text-emerald-200">Completed</span>}
        {
          run.lifecyclePhase === "in_progress" && !showCompleted && (
            <span class="ml-2 text-sm font-medium text-amber-200">In progress</span>
          )
        }
        {isArchived && <span class="ml-2 text-sm font-medium text-blue-100/70">Archived</span>}
        {
          showEdit && !isArchived && !run.completedAt && (
            <a
              href={`/runs/${run.id}/edit`}
              class="relative z-[2] ml-3 text-sm font-medium text-purple-300 transition-colors hover:text-purple-100 hover:underline"
            >
              Edit
            </a>
          )
        }
      </h3>
      <RunOrganizerByline userId={run.organizerId} nickname={run.organizerNickname} class="relative z-[2] mt-1" />
    </div>
    <time class="shrink-0 text-sm text-blue-100/70" datetime={run.startsAt}>
      {formatStart(run.startsAt, Astro.locals.timeZone)}
    </time>
  </div>
  <dl class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-blue-100/60">
    <div>
      <dt class="inline">Filled:</dt>
      <dd class="inline text-blue-100/90">
        {run.confirmedCount}/{run.maxParticipants}
      </dd>
    </div>
    {
      run.minPoints > 0 && (
        <div>
          <dt class="inline">Min points:</dt>
          <dd class="inline text-blue-100/90">{run.minPoints}</dd>
        </div>
      )
    }
    <div>
      <dt class="inline">Join:</dt>
      <dd class="inline text-blue-100/90">{formatJoinMode(run.joinMode)}</dd>
    </div>
    <div>
      <dt class="inline">Visibility:</dt>
      <dd class="inline text-blue-100/90">{formatVisibility(run.visibility)}</dd>
    </div>
    {
      pendingCount !== null &&
        pendingCount > 0 &&
        !isArchived &&
        (run.joinMode === "approval_required" || run.autoJoinMin != null) && (
          <div>
            <dt class="inline">Pending: </dt>
            <dd class="inline text-blue-100/90">{pendingCount}</dd>
          </div>
        )
    }
    <RunMapsSummary maps={run.maps} fallbackMap={run.map} mapCategory={run.mapCategory} />
  </dl>
</div>
