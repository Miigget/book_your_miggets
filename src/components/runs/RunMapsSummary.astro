---
import MapStarRating from "@/components/runs/MapStarRating.astro";
import { summarizeRunMaps, type RunMapsSummaryMap } from "@/lib/run-maps";
import { cn } from "@/lib/utils";

interface Props {
  maps: RunMapsSummaryMap[];
  fallbackMap: RunMapsSummaryMap | null;
  mapCategory: string | null;
  class?: string;
}

const { maps, fallbackMap, mapCategory, class: className } = Astro.props;
const summary = summarizeRunMaps(maps, fallbackMap, mapCategory);
const mapCount = summary.kind === "maps" ? summary.visible.length + summary.extra : 0;
const mapsLabel = mapCount === 1 ? "Map:" : "Maps:";
const singleMap = summary.kind === "maps" && mapCount === 1 ? summary.visible[0] : null;
---

{
  summary.kind === "maps" && mapCount > 1 ? (
    <p class:list={[cn(className)]}>
      {mapsLabel} <span class="text-blue-100/90">Multiple maps</span>
    </p>
  ) : singleMap ? (
    <p class:list={[cn("min-w-0", className)]}>
      {mapsLabel} <span class="text-blue-100/90">{singleMap.name}</span>
      <span class="text-blue-100/50">
        {" "}
        · {singleMap.difficulty} · <MapStarRating stars={singleMap.stars} /> · {singleMap.points} pts
      </span>
    </p>
  ) : summary.kind === "category" ? (
    <p class:list={[cn(className)]}>
      Category: <span class="text-blue-100/90">{summary.category}</span>
    </p>
  ) : null
}
