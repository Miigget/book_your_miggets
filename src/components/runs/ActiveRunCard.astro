---
import NicknameLink from "@/components/NicknameLink.astro";
import { formatStart } from "@/lib/format-date";
import { formatJoinMode, formatVisibility, type RunListItem } from "@/lib/services/runs";

interface Props {
  run: RunListItem;
}

const { run } = Astro.props;
---

<div
  class="group relative rounded-xl border border-white/10 bg-white/5 px-5 py-4 transition-colors hover:border-white/20 hover:bg-white/10"
>
  <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
    <h3 class="text-lg font-semibold text-white">
      <a
        href={`/runs/${run.id}`}
        class="group-hover:text-purple-100 group-hover:underline after:absolute after:inset-0 after:z-[1] after:rounded-xl after:content-['']"
      >
        {run.displayTitle}
      </a>
      {run.lifecyclePhase === "in_progress" && <span class="ml-2 text-sm font-medium text-amber-200">In progress</span>}
    </h3>
    <time class="shrink-0 text-sm text-blue-100/70" datetime={run.startsAt}>
      {formatStart(run.startsAt, Astro.locals.timeZone)}
    </time>
  </div>
  <dl class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-blue-100/60">
    <div>
      <dt class="inline">Filled:</dt>{" "}
      <dd class="inline text-blue-100/90">
        {run.confirmedCount}/{run.maxParticipants}
      </dd>
    </div>
    <div>
      <dt class="inline">Min points:</dt>{" "}
      <dd class="inline text-blue-100/90">{run.minPoints}</dd>
    </div>
    <div>
      <dt class="inline">Join:</dt>{" "}
      <dd class="inline text-blue-100/90">{formatJoinMode(run.joinMode)}</dd>
    </div>
    <div>
      <dt class="inline">Visibility:</dt>{" "}
      <dd class="inline text-blue-100/90">{formatVisibility(run.visibility)}</dd>
    </div>
    {
      run.map ? (
        <div>
          <dt class="inline">Map: </dt>
          <dd class="inline text-blue-100/90">
            {run.map.name}
            <span class="text-blue-100/50">
              {" "}
              · {run.map.difficulty} · {run.map.points} pts
            </span>
          </dd>
        </div>
      ) : run.mapCategory ? (
        <div>
          <dt class="inline">Category: </dt>
          <dd class="inline text-blue-100/90">{run.mapCategory}</dd>
        </div>
      ) : null
    }
    <div>
      <dt class="inline">Organizer:</dt>{" "}
      <dd class="relative z-[2] inline text-blue-100/90">
        <NicknameLink userId={run.organizerId} nickname={run.organizerNickname} />
      </dd>
    </div>
  </dl>
</div>
