---
import PageChrome from "@/components/PageChrome.astro";
import NicknameLink from "@/components/NicknameLink.astro";
import { formatStart } from "@/lib/format-date";
import { createClient } from "@/lib/supabase";
import { formatJoinMode, listActiveRuns } from "@/lib/services/runs";

const supabase = createClient(Astro.request.headers, Astro.cookies);

let recentRuns: Awaited<ReturnType<typeof listActiveRuns>> = [];
if (supabase) {
  try {
    recentRuns = (await listActiveRuns(supabase)).slice(0, 6);
  } catch {
    recentRuns = [];
  }
}
---

<PageChrome contentClass="max-w-none" flush>
  <div slot="atmosphere" class="pointer-events-none absolute inset-0">
    <div
      class="absolute top-0 left-1/2 h-[300px] w-[300px] -translate-x-1/2 rounded-full bg-indigo-400/10 blur-[140px]"
    >
    </div>
    <div
      class="absolute inset-0"
      style="background-image: radial-gradient(circle, rgba(255,255,255,0.15) 1px, transparent 1px), radial-gradient(circle, rgba(255,255,255,0.1) 1px, transparent 1px), radial-gradient(circle, rgba(255,255,255,0.07) 1px, transparent 1px); background-size: 200px 200px, 150px 150px, 100px 100px; background-position: 0 0, 40px 60px, 80px 30px;"
    >
    </div>
  </div>

  <section class="relative flex min-h-[80vh] items-center justify-center px-4">
    <div class="relative z-10 mx-auto max-w-4xl text-center">
      <h1 class="mb-4 text-6xl font-extrabold sm:text-7xl md:text-8xl">
        <span
          class="inline-block bg-gradient-to-r from-blue-200 via-purple-200 to-pink-200 bg-clip-text py-[0.12em] leading-[1.2] text-transparent"
        >
          Book Your<br />Miggets
        </span>
      </h1>
      <p class="mx-auto mb-8 max-w-2xl text-lg text-blue-100/70 sm:text-xl">
        The ultimate team finder for <span class="font-semibold text-purple-300">King of Gores</span> runs. Stop failing solo
        — find your squad and fail together!
      </p>
      <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href="/runs/new"
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-purple-600 px-8 py-4 text-lg font-medium text-white transition-colors hover:bg-purple-500"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path>
            <path d="M12 5v14"></path>
          </svg>
          Create a Run
        </a>
        <a
          href="/runs"
          class="inline-flex items-center justify-center gap-2 rounded-lg border border-white/20 px-8 py-4 text-lg font-medium text-white transition-colors hover:bg-white/10"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m21 21-4.34-4.34"></path>
            <circle cx="11" cy="11" r="8"></circle>
          </svg>
          Browse Runs
        </a>
      </div>
    </div>
  </section>

  <section class="overflow-hidden px-4 py-20">
    <div class="mx-auto max-w-5xl">
      <h2 class="mb-12 text-center text-3xl font-bold">
        <span
          class="inline-block bg-gradient-to-r from-blue-200 via-purple-200 to-pink-200 bg-clip-text py-[0.12em] leading-[1.2] text-transparent"
        >
          How It Works
        </span>
      </h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-white/10 bg-white/5 p-6 text-center backdrop-blur-xl">
          <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-purple-500/10">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="32"
              height="32"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-purple-300"
              aria-hidden="true"
            >
              <path d="M5 12h14"></path>
              <path d="M12 5v14"></path>
            </svg>
          </div>
          <h3 class="mb-2 text-lg font-bold text-white">1. Post Your Run</h3>
          <p class="text-sm text-blue-100/60">
            Pick a map, set your requirements, and create a run. Need 3 players for Ring of Gores? Easy.
          </p>
        </div>
        <div class="rounded-xl border border-white/10 bg-white/5 p-6 text-center backdrop-blur-xl">
          <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-blue-500/10">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="32"
              height="32"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-blue-300"
              aria-hidden="true"
            >
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
              <path d="M16 3.128a4 4 0 0 1 0 7.744"></path>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
              <circle cx="9" cy="7" r="4"></circle>
            </svg>
          </div>
          <h3 class="mb-2 text-lg font-bold text-white">2. Find Your Squad</h3>
          <p class="text-sm text-blue-100/60">
            Players browse and request to join. You review them and accept the ones who won&apos;t migget your run.
          </p>
        </div>
        <div class="rounded-xl border border-white/10 bg-white/5 p-6 text-center backdrop-blur-xl">
          <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-pink-500/10">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="32"
              height="32"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-pink-300"
              aria-hidden="true"
            >
              <path
                d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"
              ></path>
            </svg>
          </div>
          <h3 class="mb-2 text-lg font-bold text-white">3. Run Together</h3>
          <p class="text-sm text-blue-100/60">
            Your team is set. Jump in-game, coordinate, and crush that map. Or fail trying. Probably fail trying.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="px-4 py-16">
    <div class="mx-auto max-w-6xl">
      <div class="mb-8 flex items-center justify-between">
        <h2 class="text-2xl font-bold text-white">
          Recent <span class="text-purple-300">Runs</span>
        </h2>
        <a href="/runs" class="text-sm text-blue-100/60 transition-colors hover:text-purple-200">View all →</a>
      </div>
      {
        recentRuns.length === 0 ? (
          <p class="text-sm text-blue-100/60">No active runs yet. Be the first to post one.</p>
        ) : (
          <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            {recentRuns.map((run) => (
              <div class="flex h-full flex-col rounded-xl border border-white/10 bg-white/5 p-5 backdrop-blur-xl transition-colors hover:border-white/20 hover:bg-white/10">
                <div class="mb-3 flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <h3 class="truncate text-lg font-bold text-white">
                      <a href={`/runs/${run.id}`} class="transition-colors hover:text-purple-100 hover:underline">
                        {run.displayTitle}
                      </a>
                    </h3>
                    <p class="text-sm text-blue-100/60">
                      by <NicknameLink userId={run.organizerId} nickname={run.organizerNickname} />
                    </p>
                  </div>
                  {run.lifecyclePhase === "in_progress" && (
                    <span class="shrink-0 text-sm font-medium text-amber-200">In progress</span>
                  )}
                </div>
                <div class="mb-3 grid flex-1 grid-cols-2 gap-2 text-sm text-blue-100/60">
                  <div>
                    Filled:{" "}
                    <span class="text-blue-100/90">
                      {run.confirmedCount}/{run.maxParticipants}
                    </span>
                  </div>
                  <div>
                    Join: <span class="text-blue-100/90">{formatJoinMode(run.joinMode)}</span>
                  </div>
                  {run.map ? (
                    <div class="col-span-2">
                      Map:{" "}
                      <span class="text-blue-100/90">
                        {run.map.name}
                        <span class="text-blue-100/50">
                          {" "}
                          · {run.map.difficulty} · {run.map.points} pts
                        </span>
                      </span>
                    </div>
                  ) : run.mapCategory ? (
                    <div class="col-span-2">
                      Category: <span class="text-blue-100/90">{run.mapCategory}</span>
                    </div>
                  ) : null}
                </div>
                <time class="mt-auto border-t border-white/10 pt-3 text-xs text-blue-100/60" datetime={run.startsAt}>
                  {formatStart(run.startsAt, Astro.locals.timeZone)}
                </time>
              </div>
            ))}
          </div>
        )
      }
    </div>
  </section>
</PageChrome>
