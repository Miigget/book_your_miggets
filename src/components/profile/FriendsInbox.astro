---
import NicknameLink from "@/components/NicknameLink.astro";
import type { FriendInboxRow } from "@/lib/services/friends";

interface Props {
  verified: boolean;
  incoming: FriendInboxRow[];
  outgoing: FriendInboxRow[];
  publicProfileHref: string | null;
  redirectTo?: string;
}

const { verified, incoming, outgoing, publicProfileHref, redirectTo = "/profile" } = Astro.props;
const showIncoming = verified && incoming.length > 0;
const showOutgoing = verified && outgoing.length > 0;
const showHeadings = showIncoming && showOutgoing;

const buttonClass =
  "rounded-lg border border-white/20 px-3 py-1.5 text-xs font-medium text-white transition-colors hover:bg-white/10";
const declineClass =
  "rounded-lg border border-red-400/40 px-3 py-1.5 text-xs font-medium text-red-200 transition-colors hover:bg-red-500/20";
---

{
  (showIncoming || showOutgoing) && (
    <section class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl">
      <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="text-lg font-semibold text-white">Friend requests</h2>
        {publicProfileHref && (
          <a
            href={publicProfileHref}
            class="text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline"
          >
            View public profile
          </a>
        )}
      </div>

      <div class="space-y-6">
        {showIncoming && (
          <div>
            {showHeadings && <h3 class="mb-3 text-sm font-medium text-blue-100/80">Incoming</h3>}
            <ul class="space-y-3">
              {incoming.map((row) => (
                <li class="flex flex-wrap items-center justify-between gap-3 border-b border-white/10 pb-3 last:border-b-0 last:pb-0">
                  <NicknameLink userId={row.userId} nickname={row.nickname} />
                  <div class="flex flex-wrap gap-2">
                    <form method="POST" action="/api/friends/accept">
                      <input type="hidden" name="request_id" value={row.id} />
                      <input type="hidden" name="redirect" value={redirectTo} />
                      <button type="submit" class:list={[buttonClass]}>
                        Accept
                      </button>
                    </form>
                    <form method="POST" action="/api/friends/decline">
                      <input type="hidden" name="request_id" value={row.id} />
                      <input type="hidden" name="redirect" value={redirectTo} />
                      <button type="submit" class:list={[declineClass]}>
                        Decline
                      </button>
                    </form>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        )}

        {showOutgoing && (
          <div>
            {showHeadings && <h3 class="mb-3 text-sm font-medium text-blue-100/80">Outgoing</h3>}
            <ul class="space-y-3">
              {outgoing.map((row) => (
                <li class="flex flex-wrap items-center justify-between gap-3 border-b border-white/10 pb-3 last:border-b-0 last:pb-0">
                  <NicknameLink userId={row.userId} nickname={row.nickname} />
                  <form method="POST" action="/api/friends/cancel">
                    <input type="hidden" name="request_id" value={row.id} />
                    <input type="hidden" name="redirect" value={redirectTo} />
                    <button type="submit" class:list={[buttonClass]}>
                      Cancel
                    </button>
                  </form>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )
}
