---
import NicknameLink from "@/components/NicknameLink.astro";
import { formatStart } from "@/lib/format-date";
import type { RunInboxRow } from "@/lib/services/inbox";

interface Props {
  incoming: RunInboxRow[];
}

const { incoming } = Astro.props;
---

{
  incoming.length > 0 && (
    <section class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl">
      <h2 class="mb-4 text-lg font-semibold text-white">Run invites</h2>
      <ul class="space-y-3">
        {incoming.map((row) => (
          <li class="flex flex-wrap items-center justify-between gap-3 border-b border-white/10 pb-3 last:border-b-0 last:pb-0">
            <div class="min-w-0">
              <a
                href={`/runs/${row.id}`}
                class="text-purple-300 transition-colors hover:text-purple-100 hover:underline"
              >
                {row.displayTitle}
              </a>
              <p class="mt-0.5 text-sm text-blue-100/70">
                {row.visibilityLabel}
                {" · from "}
                <NicknameLink userId={row.organizerId} nickname={row.organizerNickname} />
              </p>
              <time class="mt-0.5 block text-xs text-blue-100/50" datetime={row.startsAt}>
                {formatStart(row.startsAt, Astro.locals.timeZone)}
              </time>
            </div>
            <a
              href={`/runs/${row.id}`}
              class="rounded-lg border border-white/20 px-3 py-1.5 text-xs font-medium text-white transition-colors hover:bg-white/10"
            >
              Open run
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
