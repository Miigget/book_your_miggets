---
import Footer from "@/components/Footer.astro";
import Topbar from "@/components/Topbar.astro";

interface Props {
  contentClass?: string;
  flush?: boolean;
}

const { contentClass = "max-w-3xl", flush = false } = Astro.props;
---

<div class="bg-cosmic relative flex min-h-screen w-full flex-col overflow-hidden">
  <div
    class="pointer-events-none absolute top-1/4 -left-24 h-[350px] w-[350px] rounded-full bg-purple-500/20 blur-[120px]"
  >
  </div>
  <div
    class="pointer-events-none absolute top-2/3 -right-16 h-[250px] w-[250px] rounded-full bg-blue-500/15 blur-[100px]"
  >
  </div>
  <slot name="atmosphere" />

  <div class="relative z-10 px-4 pt-4 sm:px-8 sm:pt-8">
    <Topbar />
  </div>
  <div
    class:list={["relative z-10 mx-auto w-full flex-1", flush ? "" : "px-4 py-4 sm:px-8 sm:pt-4 sm:pb-8", contentClass]}
  >
    <slot />
  </div>
  <Footer />
</div>
