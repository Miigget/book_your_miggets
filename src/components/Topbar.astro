---
import InboxToast from "@/components/profile/InboxToast";
import { playerProfileHref } from "@/lib/profile-href";
import { INBOX_TOAST_COOKIE, countIncomingInbox, parseInboxToastCount } from "@/lib/services/inbox";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;
const isAdmin = Astro.locals.profile?.role === "admin";
const rawNick = Astro.locals.profile?.nickname?.trim();
const nickname = rawNick !== undefined && rawNick.length > 0 ? rawNick : null;
const profileInboxHref = user ? `${playerProfileHref(user.id)}#inbox` : null;

let incomingInboxCount = 0;
if (user) {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (supabase) {
    try {
      incomingInboxCount = await countIncomingInbox(supabase, user.id);
    } catch (err) {
      console.error("inbox count failed", err);
    }
  }
}

const inboxToastCount = parseInboxToastCount(Astro.cookies.get(INBOX_TOAST_COOKIE)?.value);
if (Astro.cookies.has(INBOX_TOAST_COOKIE)) {
  Astro.cookies.delete(INBOX_TOAST_COOKIE, { path: "/" });
}

const inboxBadgeLabel = incomingInboxCount === 1 ? "1 pending invite" : `${incomingInboxCount} pending invites`;
const inboxBadgeText = incomingInboxCount > 9 ? "9+" : String(incomingInboxCount);

const navLinkClass = "text-purple-300 transition-colors hover:text-purple-100 hover:underline";
---

<div
  class="mb-4 grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-x-4 gap-y-2 rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm text-white/80"
>
  <a
    href="/"
    class="shrink-0 justify-self-start bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-base font-semibold tracking-tight text-transparent transition-opacity hover:opacity-80"
  >
    BookYourMiggets
  </a>
  {
    user ? (
      <>
        <nav class="flex flex-wrap items-center justify-center gap-3" aria-label="Primary">
          <a href="/runs" class:list={navLinkClass}>
            Runs
          </a>
          <a href="/clans" class:list={navLinkClass}>
            Clans
          </a>
          <a href="/runs/new" class:list={navLinkClass}>
            New run
          </a>
          <a href="/dashboard" class:list={navLinkClass}>
            Dashboard
          </a>
          {isAdmin && (
            <a href="/admin" class:list={navLinkClass}>
              Admin
            </a>
          )}
        </nav>
        <div class="flex min-w-0 flex-wrap items-center justify-end gap-3 justify-self-end">
          <div class="relative shrink-0">
            <a
              href={profileInboxHref}
              class="inline-flex max-w-[14rem] min-w-0 items-center gap-1.5 text-blue-100/70 transition-colors hover:text-purple-100 hover:underline"
            >
              <span class="truncate">{nickname ?? "Set nickname"}</span>
              {incomingInboxCount > 0 && (
                <span
                  class="inline-flex h-5 min-w-5 shrink-0 items-center justify-center rounded-full bg-rose-500 px-1.5 font-mono text-[11px] leading-none font-semibold text-white tabular-nums"
                  title={inboxBadgeLabel}
                  aria-label={inboxBadgeLabel}
                >
                  {inboxBadgeText}
                </span>
              )}
            </a>
            {inboxToastCount > 0 && profileInboxHref && (
              <InboxToast client:load count={inboxToastCount} href={profileInboxHref} />
            )}
          </div>
          <form method="POST" action="/api/auth/signout">
            <button type="submit" class:list={navLinkClass}>
              Sign out
            </button>
          </form>
        </div>
      </>
    ) : (
      <>
        <nav class="flex flex-wrap items-center justify-center gap-3" aria-label="Primary">
          <a href="/runs" class:list={navLinkClass}>
            Runs
          </a>
          <a href="/clans" class:list={navLinkClass}>
            Clans
          </a>
        </nav>
        <div class="flex flex-wrap items-center justify-end gap-3 justify-self-end">
          <a href="/auth/signin" class:list={navLinkClass}>
            Sign in
          </a>
          <a href="/auth/signup" class:list={navLinkClass}>
            Sign up
          </a>
        </div>
      </>
    )
  }
</div>
