---
import Layout from "@/layouts/Layout.astro";
import Banner from "@/components/Banner.astro";
import PageChrome from "@/components/PageChrome.astro";
import { PLAYER_LABEL_PALETTE } from "@/lib/player-label-palette";
import { createClient } from "@/lib/supabase";
import { countAssignmentsByLabel, listDictionary, type PlayerLabel } from "@/lib/services/player-labels";
import { cn } from "@/lib/utils";

// Route protection lives in middleware: only admins reach this page.
const supabase = createClient(Astro.request.headers, Astro.cookies);
const notice = Astro.url.searchParams.get("notice");
const serverError = Astro.url.searchParams.get("error");

let labels: PlayerLabel[] = [];
let assignmentCounts = new Map<string, number>();
let loadError: string | null = null;

if (!supabase) {
  loadError = "Supabase is not configured.";
} else {
  try {
    labels = await listDictionary(supabase);
    assignmentCounts = await countAssignmentsByLabel(supabase);
  } catch (err) {
    console.error("admin labels page load failed", err);
    loadError = "Could not load labels.";
  }
}

const fieldClass = cn(
  "w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-white placeholder-white/40",
  "focus:outline-none focus:ring-2 focus:ring-purple-400",
);
const labelClass = "mb-1 block text-sm text-blue-100/80";
const saveButtonClass = cn(
  "rounded-lg border border-white/20 px-3 py-1.5 text-sm font-medium text-white",
  "transition-colors hover:bg-white/10",
);
const deleteButtonClass = cn(
  "rounded-lg border border-red-400/40 px-3 py-1.5 text-xs font-medium text-red-200",
  "transition-colors hover:bg-red-500/20",
);
const swatchRadioClass = "peer sr-only";
const swatchLabelClass = cn(
  "inline-flex cursor-pointer items-center gap-2 rounded-lg border border-white/15 px-2.5 py-1.5 text-xs text-blue-100/80",
  "transition-colors peer-checked:border-white/50 peer-checked:bg-white/10 peer-focus-visible:ring-2 peer-focus-visible:ring-purple-400",
);
---

<Layout title="Labels — Admin — Book Your Miggets">
  <PageChrome>
    {
      notice && (
        <div class="mb-6 overflow-hidden rounded-lg">
          <Banner variant="info">{notice}</Banner>
        </div>
      )
    }
    {
      serverError && (
        <div class="mb-6 overflow-hidden rounded-lg">
          <Banner variant="error">{serverError}</Banner>
        </div>
      )
    }

    <p class="mb-6">
      <a href="/admin" class="text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline">
        ← Users
      </a>
    </p>

    <header class="mb-8">
      <h1
        class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent sm:text-4xl"
      >
        Player labels
      </h1>
      <p class="mt-2 text-sm text-blue-100/60">
        Maintain the label dictionary. Assign labels on a player's admin page; they appear on public profiles.
      </p>
    </header>

    {
      loadError ? (
        <p class="rounded-lg border border-red-400/30 bg-red-500/10 px-4 py-3 text-sm text-red-100">{loadError}</p>
      ) : (
        <>
          {labels.length === 0 ? (
            <div class="mb-8 rounded-xl border border-white/10 bg-white/5 px-6 py-10 text-center backdrop-blur-xl">
              <p class="text-lg font-medium text-white">No labels yet</p>
              <p class="mt-2 text-sm text-blue-100/60">
                Create labels here. Assigned chips show on each player's public profile.
              </p>
            </div>
          ) : null}

          <section
            class="mb-8 rounded-xl border border-white/10 bg-white/5 p-5 backdrop-blur-xl"
            aria-label="Create label"
          >
            <h2 class="mb-4 text-sm font-semibold tracking-wide text-white/80 uppercase">Create label</h2>
            <form method="POST" action="/api/admin/labels" class="space-y-4">
              <div>
                <label for="create-label-name" class:list={[labelClass]}>
                  Name
                </label>
                <input
                  id="create-label-name"
                  type="text"
                  name="name"
                  required
                  maxlength="24"
                  autocomplete="off"
                  class:list={[fieldClass]}
                />
              </div>
              <fieldset>
                <legend class:list={[labelClass]}>Color</legend>
                <div class="mt-2 flex flex-wrap gap-2">
                  {PLAYER_LABEL_PALETTE.map((swatch, index) => (
                    <label class="inline-flex">
                      <input
                        type="radio"
                        name="color"
                        value={swatch.hex}
                        required
                        checked={index === 0}
                        class:list={[swatchRadioClass]}
                      />
                      <span class:list={[swatchLabelClass]}>
                        <span
                          class="inline-block size-3.5 rounded-sm border border-white/30"
                          style={`background-color: ${swatch.hex}`}
                          aria-hidden="true"
                        />
                        {swatch.name}
                      </span>
                    </label>
                  ))}
                </div>
              </fieldset>
              <button type="submit" class:list={[saveButtonClass]}>
                Create label
              </button>
            </form>
          </section>

          {labels.length > 0 ? (
            <ul class="flex flex-col gap-4" aria-label="Existing labels">
              {labels.map((label) => {
                const usedBy = assignmentCounts.get(label.id) ?? 0;
                const playerWord = usedBy === 1 ? "player" : "players";
                return (
                  <li class="rounded-xl border border-white/10 bg-white/5 p-5 backdrop-blur-xl">
                    <div class="mb-4 flex flex-wrap items-center gap-3">
                      <span
                        class="inline-block size-4 rounded-sm border border-white/30"
                        style={`background-color: ${label.color}`}
                        aria-hidden="true"
                      />
                      <h3 class="text-lg font-semibold text-white">{label.name}</h3>
                      <p class="text-xs text-blue-100/50">
                        Used by {usedBy} {playerWord}
                      </p>
                    </div>

                    <form method="POST" action={`/api/admin/labels/${label.id}`} class="space-y-4">
                      <div>
                        <label for={`edit-name-${label.id}`} class:list={[labelClass]}>
                          Name
                        </label>
                        <input
                          id={`edit-name-${label.id}`}
                          type="text"
                          name="name"
                          required
                          maxlength="24"
                          autocomplete="off"
                          value={label.name}
                          class:list={[fieldClass]}
                        />
                      </div>
                      <fieldset>
                        <legend class:list={[labelClass]}>Color</legend>
                        <div class="mt-2 flex flex-wrap gap-2">
                          {PLAYER_LABEL_PALETTE.map((swatch) => (
                            <label class="inline-flex">
                              <input
                                type="radio"
                                name="color"
                                value={swatch.hex}
                                required
                                checked={swatch.hex === label.color.toUpperCase()}
                                class:list={[swatchRadioClass]}
                              />
                              <span class:list={[swatchLabelClass]}>
                                <span
                                  class="inline-block size-3.5 rounded-sm border border-white/30"
                                  style={`background-color: ${swatch.hex}`}
                                  aria-hidden="true"
                                />
                                {swatch.name}
                              </span>
                            </label>
                          ))}
                        </div>
                      </fieldset>
                      <button type="submit" class:list={[saveButtonClass]}>
                        Save label
                      </button>
                    </form>

                    <form method="POST" action={`/api/admin/labels/${label.id}/delete`} class="mt-4">
                      <button type="submit" class:list={[deleteButtonClass]}>
                        Delete · Used by {usedBy}
                      </button>
                    </form>
                  </li>
                );
              })}
            </ul>
          ) : null}
        </>
      )
    }
  </PageChrome>
</Layout>
