---
import Layout from "@/layouts/Layout.astro";
import PageChrome from "@/components/PageChrome.astro";
import DashboardRunSection from "@/components/runs/DashboardRunSection.astro";
import { createClient } from "@/lib/supabase";
import { listRunsForOrganizer, listRunsForParticipant } from "@/lib/services/runs";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const { user } = Astro.locals;
const activeTab = Astro.url.searchParams.get("tab") === "past" ? "past" : "incoming";

let created: Awaited<ReturnType<typeof listRunsForOrganizer>> = { active: [], archived: [] };
let joined: Awaited<ReturnType<typeof listRunsForParticipant>> = { active: [], archived: [] };
let loadError: string | null = null;

if (!supabase) {
  loadError = "Supabase is not configured.";
} else if (!user) {
  loadError = "Authentication required.";
} else {
  try {
    [created, joined] = await Promise.all([
      listRunsForOrganizer(supabase, user.id),
      listRunsForParticipant(supabase, user.id),
    ]);
  } catch (err) {
    console.error("dashboard run lists failed", err);
    loadError = "Could not load your runs.";
  }
}

const createdIncoming = created.active;
const createdPast = created.archived;
const joinedIncoming = user ? joined.active.filter((run) => run.organizerId !== user.id) : [];
const joinedPast = user ? joined.archived.filter((run) => run.organizerId !== user.id) : [];

const incomingCount = createdIncoming.length + joinedIncoming.length;
const pastCount = createdPast.length + joinedPast.length;
const hasAnyRuns = incomingCount > 0 || pastCount > 0;
---

<Layout title="Your runs — Book Your Miggets">
  <PageChrome>
    <header class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h1
          class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent sm:text-4xl"
        >
          Your runs
        </h1>
        <p class="mt-2 text-sm text-blue-100/60">Runs you created and runs you&apos;re on as a teammate.</p>
      </div>
      {
        !loadError && hasAnyRuns && (
          <a
            href="/runs/new"
            class="inline-flex items-center justify-center rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
          >
            Create a run
          </a>
        )
      }
    </header>

    {
      loadError ? (
        <p class="rounded-lg border border-red-400/30 bg-red-500/10 px-4 py-3 text-sm text-red-100">{loadError}</p>
      ) : !hasAnyRuns ? (
        <div class="rounded-xl border border-white/10 bg-white/5 px-6 py-12 text-center backdrop-blur-xl">
          <p class="text-lg font-medium text-white">No runs yet</p>
          <p class="mt-2 text-sm text-blue-100/60">Create a run or join one from the public list.</p>
          <div class="mt-4 flex flex-wrap items-center justify-center gap-3">
            <a
              href="/runs/new"
              class="inline-flex items-center justify-center rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
            >
              Create a run
            </a>
            <a
              href="/runs"
              class="inline-flex items-center justify-center rounded-lg border border-white/20 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-white/10"
            >
              Browse runs
            </a>
          </div>
        </div>
      ) : (
        <div class="flex flex-col gap-8">
          <nav aria-label="Run timeframe" class="flex w-fit gap-1 rounded-lg border border-white/10 bg-white/5 p-1">
            <a
              href="/dashboard"
              class:list={[
                "rounded-md px-3 py-1.5 text-sm font-medium transition-colors",
                activeTab === "incoming"
                  ? "bg-purple-600 text-white"
                  : "text-blue-100/70 hover:bg-white/10 hover:text-white",
              ]}
              aria-current={activeTab === "incoming" ? "page" : undefined}
            >
              Incoming
              <span class:list={["ml-1.5", activeTab === "incoming" ? "text-white/70" : "text-blue-100/40"]}>
                {incomingCount}
              </span>
            </a>
            <a
              href="/dashboard?tab=past"
              class:list={[
                "rounded-md px-3 py-1.5 text-sm font-medium transition-colors",
                activeTab === "past"
                  ? "bg-purple-600 text-white"
                  : "text-blue-100/70 hover:bg-white/10 hover:text-white",
              ]}
              aria-current={activeTab === "past" ? "page" : undefined}
            >
              Past
              <span class:list={["ml-1.5", activeTab === "past" ? "text-white/70" : "text-blue-100/40"]}>
                {pastCount}
              </span>
            </a>
          </nav>

          {activeTab === "incoming" ? (
            <div class="flex flex-col gap-10">
              <DashboardRunSection heading="Created by you" empty="None right now" runs={createdIncoming} showEdit />
              <DashboardRunSection heading="You're on the team" empty="None right now" runs={joinedIncoming} />
            </div>
          ) : (
            <div class="flex flex-col gap-10">
              <DashboardRunSection heading="Created by you" empty="None yet" runs={createdPast} />
              <DashboardRunSection heading="You're on the team" empty="None yet" runs={joinedPast} />
            </div>
          )}
        </div>
      )
    }
  </PageChrome>
</Layout>
