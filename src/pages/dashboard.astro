---
import Layout from "@/layouts/Layout.astro";
import NicknameLink from "@/components/NicknameLink.astro";
import PageChrome from "@/components/PageChrome.astro";
import { formatStart } from "@/lib/format-date";
import { createClient } from "@/lib/supabase";
import { formatJoinMode, listRunsForOrganizer } from "@/lib/services/runs";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const { user } = Astro.locals;

let inventory: Awaited<ReturnType<typeof listRunsForOrganizer>> = { active: [], archived: [] };
let loadError: string | null = null;

if (!supabase) {
  loadError = "Supabase is not configured.";
} else if (!user) {
  loadError = "Authentication required.";
} else {
  try {
    inventory = await listRunsForOrganizer(supabase, user.id);
  } catch (err) {
    console.error("listRunsForOrganizer failed on dashboard", err);
    loadError = "Could not load your runs.";
  }
}

const { active, archived } = inventory;
const hasCreatedRuns = active.length > 0 || archived.length > 0;
---

<Layout title="Your runs — Book Your Miggets">
  <PageChrome>
    <header class="mb-8">
      <h1
        class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent sm:text-4xl"
      >
        Your runs
      </h1>
      <p class="mt-2 text-sm text-blue-100/60">Runs you created, active and past.</p>
    </header>

    {
      loadError ? (
        <p class="rounded-lg border border-red-400/30 bg-red-500/10 px-4 py-3 text-sm text-red-100">{loadError}</p>
      ) : !hasCreatedRuns ? (
        <div class="rounded-xl border border-white/10 bg-white/5 px-6 py-12 text-center backdrop-blur-xl">
          <p class="text-lg font-medium text-white">You haven&apos;t created a run yet</p>
          <p class="mt-2 text-sm text-blue-100/60">Create a run to see it here.</p>
          <a
            href="/runs/new"
            class="mt-4 inline-flex items-center justify-center rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
          >
            Create a run
          </a>
        </div>
      ) : (
        <div class="flex flex-col gap-10">
          <section>
            <h2 class="mb-3 text-xl font-semibold text-white">Active you created</h2>
            {active.length === 0 ? (
              <p class="text-sm text-blue-100/60">None right now</p>
            ) : (
              <ul class="flex flex-col gap-3">
                {active.map((run) => (
                  <li>
                    <div class="rounded-xl border border-white/10 bg-white/5 px-5 py-4 transition-colors hover:border-white/20 hover:bg-white/10">
                      <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                        <h3 class="text-lg font-semibold text-white">
                          <a href={`/runs/${run.id}`} class="transition-colors hover:text-purple-100 hover:underline">
                            {run.displayTitle}
                          </a>
                          {run.lifecyclePhase === "in_progress" && (
                            <span class="ml-2 text-sm font-medium text-amber-200">In progress</span>
                          )}
                        </h3>
                        <time class="shrink-0 text-sm text-blue-100/70" datetime={run.startsAt}>
                          {formatStart(run.startsAt)}
                        </time>
                      </div>
                      <dl class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-blue-100/60">
                        <div>
                          <dt class="inline">Filled: </dt>
                          <dd class="inline text-blue-100/90">
                            {run.confirmedCount}/{run.maxParticipants}
                          </dd>
                        </div>
                        <div>
                          <dt class="inline">Min points: </dt>
                          <dd class="inline text-blue-100/90">{run.minPoints}</dd>
                        </div>
                        <div>
                          <dt class="inline">Join: </dt>
                          <dd class="inline text-blue-100/90">{formatJoinMode(run.joinMode)}</dd>
                        </div>
                        {run.joinMode === "approval_required" && (
                          <div>
                            <dt class="inline">Pending: </dt>
                            <dd class="inline text-blue-100/90">{run.pendingCount}</dd>
                          </div>
                        )}
                        {run.map && (
                          <div>
                            <dt class="inline">Map: </dt>
                            <dd class="inline text-blue-100/90">
                              {run.map.name}
                              <span class="text-blue-100/50">
                                {" "}
                                · {run.map.difficulty} · {run.map.points} pts
                              </span>
                            </dd>
                          </div>
                        )}
                        <div>
                          <dt class="inline">Organizer: </dt>
                          <dd class="inline text-blue-100/90">
                            <NicknameLink userId={run.organizerId} nickname={run.organizerNickname} />
                          </dd>
                        </div>
                      </dl>
                    </div>
                  </li>
                ))}
              </ul>
            )}
          </section>

          <section>
            <h2 class="mb-3 text-xl font-semibold text-white">Past you created</h2>
            {archived.length === 0 ? (
              <p class="text-sm text-blue-100/60">None right now</p>
            ) : (
              <ul class="flex flex-col gap-3">
                {archived.map((run) => (
                  <li>
                    <div class="rounded-xl border border-white/10 bg-white/5 px-5 py-4 transition-colors hover:border-white/20 hover:bg-white/10">
                      <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                        <h3 class="text-lg font-semibold text-white">
                          <a href={`/runs/${run.id}`} class="transition-colors hover:text-purple-100 hover:underline">
                            {run.displayTitle}
                          </a>
                          <span class="ml-2 text-sm font-medium text-blue-100/70">Archived</span>
                        </h3>
                        <time class="shrink-0 text-sm text-blue-100/70" datetime={run.startsAt}>
                          {formatStart(run.startsAt)}
                        </time>
                      </div>
                      <dl class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-blue-100/60">
                        <div>
                          <dt class="inline">Filled: </dt>
                          <dd class="inline text-blue-100/90">
                            {run.confirmedCount}/{run.maxParticipants}
                          </dd>
                        </div>
                        <div>
                          <dt class="inline">Min points: </dt>
                          <dd class="inline text-blue-100/90">{run.minPoints}</dd>
                        </div>
                        <div>
                          <dt class="inline">Join: </dt>
                          <dd class="inline text-blue-100/90">{formatJoinMode(run.joinMode)}</dd>
                        </div>
                        {run.map && (
                          <div>
                            <dt class="inline">Map: </dt>
                            <dd class="inline text-blue-100/90">
                              {run.map.name}
                              <span class="text-blue-100/50">
                                {" "}
                                · {run.map.difficulty} · {run.map.points} pts
                              </span>
                            </dd>
                          </div>
                        )}
                        <div>
                          <dt class="inline">Organizer: </dt>
                          <dd class="inline text-blue-100/90">
                            <NicknameLink userId={run.organizerId} nickname={run.organizerNickname} />
                          </dd>
                        </div>
                      </dl>
                    </div>
                  </li>
                ))}
              </ul>
            )}
          </section>
        </div>
      )
    }
  </PageChrome>
</Layout>
