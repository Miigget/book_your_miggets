---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";
import { isDevQuickLoginEnabled } from "@/lib/dev-quick-login";
import { safeRunReturnTo, withReturnTo } from "@/lib/safe-return-to";

const error = Astro.url.searchParams.get("error");
const returnTo = safeRunReturnTo(Astro.url.searchParams.get("returnTo"));
const showDevQuickLogin = isDevQuickLoginEnabled();
---

<Layout title="Sign in">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1
        class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent"
      >
        Sign in
      </h1>
      <SignInForm serverError={error} returnTo={returnTo} client:load />
      {
        showDevQuickLogin && (
          <div class="mt-4 space-y-2">
            <form method="POST" action="/api/auth/dev-quick-login">
              {returnTo ? <input type="hidden" name="returnTo" value={returnTo} /> : null}
              <input type="hidden" name="account" value="avolicious" />
              <button
                type="submit"
                class="w-full rounded-lg border border-amber-400/40 bg-amber-500/15 px-4 py-2 text-sm font-medium text-amber-100 transition-colors hover:bg-amber-500/25"
              >
                Szybkie logowanie (Avolicious)
              </button>
            </form>
            <form method="POST" action="/api/auth/dev-quick-login">
              {returnTo ? <input type="hidden" name="returnTo" value={returnTo} /> : null}
              <input type="hidden" name="account" value="qshar" />
              <button
                type="submit"
                class="w-full rounded-lg border border-sky-400/40 bg-sky-500/15 px-4 py-2 text-sm font-medium text-sky-100 transition-colors hover:bg-sky-500/25"
              >
                Szybkie logowanie (QshaR)
              </button>
            </form>
            <p class="text-center text-xs text-amber-100/50">Tylko lokalny dev — nie działa na produkcji</p>
          </div>
        )
      }
      <p class="mt-4 text-center text-sm text-blue-100/60">
        Don't have an account?{" "}
        <a href={withReturnTo("/auth/signup", returnTo)} class="text-purple-300 hover:underline">Sign up</a>
      </p>
    </div>
  </div>
</Layout>
