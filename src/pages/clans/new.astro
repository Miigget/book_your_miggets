---
import Layout from "@/layouts/Layout.astro";
import PageChrome from "@/components/PageChrome.astro";
import CreateClanForm from "@/components/clans/CreateClanForm";
import { createClient } from "@/lib/supabase";
import { getOwnProfile } from "@/lib/services/profile";
import { ClanError, getClanMembershipForUser, type ClanMembership } from "@/lib/services/clans";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const { user } = Astro.locals;
const error = Astro.url.searchParams.get("error");
const isBanned = Boolean(Astro.locals.profile?.isBanned);

let isVerified = false;
let membership: ClanMembership | null = null;
let loadError: string | null = null;

if (!supabase || !user) {
  loadError = "Supabase is not configured.";
} else if (!isBanned) {
  try {
    const own = await getOwnProfile(supabase, user.id);
    isVerified = own.isVerified;
    membership = await getClanMembershipForUser(supabase, user.id);
  } catch (err) {
    loadError = err instanceof ClanError ? err.message : "Failed to load create form.";
  }
}
---

<Layout title="Create a clan — Book Your Miggets">
  <PageChrome contentClass="max-w-xl">
    <p class="mb-6">
      <a href="/" class="text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline"> ← Home </a>
    </p>

    <header class="mb-8">
      <h1
        class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent sm:text-4xl"
      >
        Create a clan
      </h1>
      <p class="mt-2 text-sm text-blue-100/60">Choose a name and tag. A picture is optional.</p>
    </header>

    {
      isBanned ? (
        <p class="rounded-lg border border-red-400/30 bg-red-500/10 px-4 py-3 text-sm text-red-100">
          Your account is banned — you cannot create clans.
        </p>
      ) : loadError ? (
        <p class="rounded-lg border border-red-400/30 bg-red-500/10 px-4 py-3 text-sm text-red-100">{loadError}</p>
      ) : !isVerified ? (
        <p class="text-sm text-blue-100/70">
          Clans require a verified account. Ask an admin to verify you before you can create a clan.
        </p>
      ) : membership ? (
        <div class="space-y-3 text-sm text-blue-100/70">
          <p>You already belong to a clan. You can only be in one clan at a time.</p>
          <p>
            <a
              href={`/clans/${membership.clanId}`}
              class="text-purple-300 transition-colors hover:text-purple-100 hover:underline"
            >
              View your clan
            </a>
          </p>
        </div>
      ) : (
        <div class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl">
          <CreateClanForm serverError={error} client:load />
        </div>
      )
    }
  </PageChrome>
</Layout>
