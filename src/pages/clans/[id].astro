---
import Layout from "@/layouts/Layout.astro";
import Banner from "@/components/Banner.astro";
import NicknameLink from "@/components/NicknameLink.astro";
import PageChrome from "@/components/PageChrome.astro";
import AdminClanControls from "@/components/clans/AdminClanControls";
import ClanTagPlaceholder from "@/components/clans/ClanTagPlaceholder.astro";
import InviteFriendsForm from "@/components/clans/InviteFriendsForm";
import ClanProfileRunSections from "@/components/clans/ClanProfileRunSections.astro";
import { createClient } from "@/lib/supabase";
import { CLAN_PICTURES_BUCKET, publicObjectUrl } from "@/lib/storage";
import { getClanById, listEligibleClanInvitees, type ClanDetail, type ClanInvitee } from "@/lib/services/clans";
import {
  CLAN_PROFILE_RUN_PREVIEW_LIMIT,
  listClanRuns,
  listConfirmedRunIdsForViewer,
  type ArchivedRunListItem,
  type RunListItem,
} from "@/lib/services/runs";

const { id } = Astro.params;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const isAdmin = Astro.locals.profile?.role === "admin";
const { user } = Astro.locals;
const notice = Astro.url.searchParams.get("notice");
const serverError = Astro.url.searchParams.get("error");

let clan: ClanDetail | null = null;
let pageError: "missing" | "config" | "load" | null = null;
let eligibleInvitees: ClanInvitee[] = [];
let incomingRuns: RunListItem[] = [];
let recentRuns: ArchivedRunListItem[] = [];
let runsError: string | null = null;
let viewerConfirmedRunIds = new Set<string>();

if (!id) {
  pageError = "missing";
} else if (!supabase) {
  pageError = "config";
} else {
  try {
    clan = await getClanById(supabase, id);
    if (!clan) {
      pageError = "missing";
    }
  } catch (err) {
    console.error("getClanById failed on public clan page", err);
    pageError = "load";
  }
}

if (pageError === "missing") {
  Astro.response.status = 404;
} else if (pageError === "load" || pageError === "config") {
  Astro.response.status = 500;
}

const isOwner = Boolean(clan && user?.id === clan.ownerId);
const viewerIsClanMember = Boolean(clan && user && clan.members.some((member) => member.id === user.id));
if (isOwner && supabase && clan && user) {
  try {
    eligibleInvitees = await listEligibleClanInvitees(supabase, user.id, clan.id);
  } catch (err) {
    console.error("listEligibleClanInvitees failed on clan detail", err);
  }
}

if (clan && supabase) {
  try {
    const listed = await listClanRuns(supabase, clan.id);
    incomingRuns = listed.active.slice(0, CLAN_PROFILE_RUN_PREVIEW_LIMIT);
    recentRuns = listed.archived.slice(0, CLAN_PROFILE_RUN_PREVIEW_LIMIT);
  } catch (err) {
    console.error("listClanRuns failed on public clan page", err);
    runsError = "Could not load clan runs";
  }

  if (user && (incomingRuns.length > 0 || recentRuns.length > 0)) {
    try {
      viewerConfirmedRunIds = await listConfirmedRunIdsForViewer(supabase, user.id, [
        ...incomingRuns.map((run) => run.id),
        ...recentRuns.map((run) => run.id),
      ]);
    } catch (err) {
      console.error("listConfirmedRunIdsForViewer failed on public clan page", err);
    }
  }
}

const pictureUrl =
  clan?.picturePath && supabase ? publicObjectUrl(supabase, CLAN_PICTURES_BUCKET, clan.picturePath) : null;
const pageTitle = clan ? `${clan.name} — Book Your Miggets` : "Clan — Book Your Miggets";
---

<Layout title={pageTitle}>
  <PageChrome contentClass="max-w-5xl">
    <p class="mb-6">
      <a href="/clans" class="text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline">
        ← Clans
      </a>
    </p>

    {
      notice && (
        <div class="mb-6 overflow-hidden rounded-lg">
          <Banner variant="info">{notice}</Banner>
        </div>
      )
    }
    {
      serverError && (!isAdmin || isOwner) && (
        <div class="mb-6 overflow-hidden rounded-lg">
          <Banner variant="error">{serverError}</Banner>
        </div>
      )
    }

    {
      pageError === "missing" ? (
        <div class="rounded-xl border border-white/10 bg-white/5 px-6 py-12 text-center backdrop-blur-xl">
          <h1 class="text-2xl font-bold text-white">Clan not found</h1>
          <p class="mt-2 text-sm text-blue-100/60">This clan is missing.</p>
        </div>
      ) : pageError ? (
        <div class="rounded-xl border border-red-400/30 bg-red-500/10 px-6 py-12 text-center">
          <h1 class="text-2xl font-bold text-white">Could not load clan</h1>
          <p class="mt-2 text-sm text-red-100/80">
            {pageError === "config" ? "Supabase is not configured." : "Please try again later."}
          </p>
        </div>
      ) : (
        clan && (
          <>
            <header class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
              <div class="flex min-w-0 items-center gap-4">
                {pictureUrl ? (
                  <img
                    src={pictureUrl}
                    alt=""
                    class="h-20 w-20 shrink-0 rounded-xl object-cover"
                    width="80"
                    height="80"
                  />
                ) : (
                  <ClanTagPlaceholder tag={clan.tag} size="lg" />
                )}
                <h1 class="min-w-0 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold break-all text-transparent sm:text-4xl">
                  {clan.name}
                </h1>
              </div>
              <a
                href={`/clans/${clan.id}/history`}
                class="inline-flex shrink-0 items-center justify-center rounded-lg border border-white/20 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-white/10"
              >
                Run history
              </a>
            </header>

            <section class="mb-8 rounded-xl border border-white/10 bg-white/5 px-5 py-5 backdrop-blur-xl">
              <h2 class="mb-4 text-sm font-semibold tracking-wide text-white/80 uppercase">Clan</h2>
              <dl class="grid grid-cols-1 gap-3 text-sm sm:grid-cols-2">
                <div>
                  <dt class="text-blue-100/50">Name</dt>
                  <dd class="mt-0.5 text-white">{clan.name}</dd>
                </div>
                <div>
                  <dt class="text-blue-100/50">Tag</dt>
                  <dd class="mt-0.5 text-white">{clan.tag}</dd>
                </div>
                <div>
                  <dt class="text-blue-100/50">Points</dt>
                  <dd class="mt-0.5 text-white">{clan.points}</dd>
                </div>
              </dl>
            </section>

            <section class="mb-8 rounded-xl border border-white/10 bg-white/5 px-5 py-5 backdrop-blur-xl">
              <h2 class="mb-4 text-sm font-semibold tracking-wide text-white/80 uppercase">Members</h2>
              {clan.members.length === 0 ? (
                <p class="text-sm text-blue-100/60">No members yet</p>
              ) : (
                <ul class="flex flex-wrap gap-x-4 gap-y-2">
                  {clan.members.map((member) => (
                    <li>
                      <NicknameLink userId={member.id} nickname={member.nickname} />
                    </li>
                  ))}
                </ul>
              )}
            </section>

            <ClanProfileRunSections
              incoming={incomingRuns}
              recent={recentRuns}
              historyHref={`/clans/${clan.id}/history`}
              loadError={runsError}
              viewerId={user?.id ?? null}
              viewerIsAdmin={isAdmin}
              viewerIsClanMember={viewerIsClanMember}
              viewerConfirmedRunIds={viewerConfirmedRunIds}
            />

            {isOwner && (
              <section class="mb-8 rounded-xl border border-white/10 bg-white/5 px-5 py-5 backdrop-blur-xl">
                <h2 class="mb-4 text-sm font-semibold tracking-wide text-white/80 uppercase">Invite friends</h2>
                <InviteFriendsForm client:load clanId={clan.id} friends={eligibleInvitees} />
              </section>
            )}

            {isAdmin && (
              <section class="mb-8 rounded-xl border border-red-400/20 bg-red-500/5 px-5 py-5 backdrop-blur-xl">
                <AdminClanControls
                  client:load
                  clanId={clan.id}
                  name={clan.name}
                  tag={clan.tag}
                  serverError={serverError}
                />
              </section>
            )}
          </>
        )
      )
    }
  </PageChrome>
</Layout>
