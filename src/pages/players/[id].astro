---
import Layout from "@/layouts/Layout.astro";
import Banner from "@/components/Banner.astro";
import PageChrome from "@/components/PageChrome.astro";
import NicknameLink from "@/components/NicknameLink.astro";
import PlayerLabelChip from "@/components/PlayerLabelChip.astro";
import ClanInvitesInbox from "@/components/profile/ClanInvitesInbox.astro";
import FriendActions from "@/components/profile/FriendActions";
import FriendsInbox from "@/components/profile/FriendsInbox.astro";
import PlayerProfileRunSections from "@/components/profile/PlayerProfileRunSections.astro";
import RunInvitesInbox from "@/components/profile/RunInvitesInbox.astro";
import RunPreviewShell from "@/components/runs/RunPreviewShell.astro";
import { createClient } from "@/lib/supabase";
import { getOwnProfile, getPublicProfile, type PublicProfile } from "@/lib/services/profile";
import {
  getRelationship,
  listIncomingPending,
  listOutgoingPending,
  listPublicFriends,
  type FriendInboxRow,
  type FriendRelationship,
  type PublicFriend,
} from "@/lib/services/friends";
import { listIncomingClanInvites, listOutgoingClanInvites, type ClanInviteInboxRow } from "@/lib/services/clans";
import { listIncomingRunInvites, type RunInboxRow } from "@/lib/services/inbox";
import { listAssignedLabels, type PlayerLabel } from "@/lib/services/player-labels";
import { playerProfileHref } from "@/lib/profile-href";
import {
  listConfirmedRunIdsForViewer,
  listPlayerProfileRuns,
  type ArchivedRunListItem,
  type RunListItem,
} from "@/lib/services/runs";

const { id } = Astro.params;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const { user } = Astro.locals;

let profile: PublicProfile | null = null;
let pageError: "missing" | "config" | "load" | null = null;
let friends: PublicFriend[] = [];
let friendsError: string | null = null;
let friendCta: FriendRelationship | null = null;
let labels: PlayerLabel[] = [];
let labelsError: string | null = null;
let incomingRuns: RunListItem[] = [];
let recentRuns: ArchivedRunListItem[] = [];
let runsError: string | null = null;
let viewerConfirmedRunIds = new Set<string>();
let incomingFriendRequests: FriendInboxRow[] = [];
let outgoingFriendRequests: FriendInboxRow[] = [];
let incomingClanInvites: ClanInviteInboxRow[] = [];
let outgoingClanInvites: ClanInviteInboxRow[] = [];
let incomingRunInvites: RunInboxRow[] = [];
let inboxError: string | null = null;

if (!id) {
  pageError = "missing";
} else if (!supabase) {
  pageError = "config";
} else {
  try {
    profile = await getPublicProfile(supabase, id);
    if (!profile) {
      pageError = "missing";
    }
  } catch (err) {
    console.error("getPublicProfile failed on public player page", err);
    pageError = "load";
  }
}

if (profile && supabase) {
  try {
    labels = await listAssignedLabels(supabase, profile.id);
  } catch (err) {
    console.error("listAssignedLabels failed on public player page", err);
    labelsError = "Could not load labels";
  }

  try {
    friends = await listPublicFriends(supabase, profile.id);
  } catch (err) {
    console.error("listPublicFriends failed on public player page", err);
    friendsError = "Could not load friends";
  }

  try {
    const listed = await listPlayerProfileRuns(supabase, profile.id);
    incomingRuns = listed.incoming;
    recentRuns = listed.recent;
  } catch (err) {
    console.error("listPlayerProfileRuns failed on public player page", err);
    runsError = "Could not load runs";
  }

  if (user && recentRuns.length > 0) {
    try {
      viewerConfirmedRunIds = await listConfirmedRunIdsForViewer(
        supabase,
        user.id,
        recentRuns.map((run) => run.id),
      );
    } catch (err) {
      console.error("listConfirmedRunIdsForViewer failed on public player page", err);
    }
  }

  if (user && user.id !== profile.id) {
    try {
      const own = await getOwnProfile(supabase, user.id);
      if (own.isVerified && profile.isVerified) {
        friendCta = await getRelationship(supabase, user.id, profile.id);
      }
    } catch (err) {
      console.error("friend relationship load failed on public player page", err);
    }
  }

  if (user?.id === profile.id) {
    try {
      if (profile.isVerified) {
        const [incomingRows, outgoingRows, incomingClanRows, outgoingClanRows, incomingRunRows] = await Promise.all([
          listIncomingPending(supabase, user.id),
          listOutgoingPending(supabase, user.id),
          listIncomingClanInvites(supabase, user.id),
          listOutgoingClanInvites(supabase, user.id),
          listIncomingRunInvites(supabase, user.id),
        ]);
        incomingFriendRequests = incomingRows;
        outgoingFriendRequests = outgoingRows;
        incomingClanInvites = incomingClanRows;
        outgoingClanInvites = outgoingClanRows;
        incomingRunInvites = incomingRunRows;
      }
    } catch (err) {
      console.error("owner inbox load failed on public player page", err);
      inboxError = "Could not load invitations";
    }
  }
}

if (pageError === "missing") {
  Astro.response.status = 404;
} else if (pageError === "load" || pageError === "config") {
  Astro.response.status = 500;
}

const displayNickname = profile?.nickname ?? "—";
const pageTitle = profile ? `${displayNickname} — Book Your Miggets` : "Player — Book Your Miggets";
const isOwnProfile = Boolean(user?.id && user.id === profile?.id);
const kogPointsLabel = profile && profile.kogPoints !== null ? String(profile.kogPoints) : "—";
const viewerIsAdmin = Astro.locals.profile?.role === "admin";
const notice = isOwnProfile ? Astro.url.searchParams.get("notice") : null;
const serverError = isOwnProfile ? Astro.url.searchParams.get("error") : null;
const ownerInboxHref = profile ? playerProfileHref(profile.id) : "/profile";
const showOwnerInbox =
  isOwnProfile &&
  (Boolean(inboxError) ||
    incomingFriendRequests.length > 0 ||
    outgoingFriendRequests.length > 0 ||
    incomingClanInvites.length > 0 ||
    outgoingClanInvites.length > 0 ||
    incomingRunInvites.length > 0);
---

<Layout title={pageTitle}>
  <PageChrome flush contentClass="max-w-none">
    <div class="px-4 py-4 sm:pb-8">
      <RunPreviewShell>
        <p class="mb-6">
          <a href="/runs" class="text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            ← Active runs
          </a>
        </p>

        {
          pageError === "missing" ? (
            <div class="rounded-xl border border-white/10 bg-white/5 px-6 py-12 text-center backdrop-blur-xl">
              <h1 class="text-2xl font-bold text-white">Player not found</h1>
              <p class="mt-2 text-sm text-blue-100/60">This player is missing.</p>
            </div>
          ) : pageError ? (
            <div class="rounded-xl border border-red-400/30 bg-red-500/10 px-6 py-12 text-center">
              <h1 class="text-2xl font-bold text-white">Could not load player</h1>
              <p class="mt-2 text-sm text-red-100/80">
                {pageError === "config" ? "Supabase is not configured." : "Please try again later."}
              </p>
            </div>
          ) : (
            profile && (
              <>
                {notice && (
                  <div class="mb-6 overflow-hidden rounded-lg">
                    <Banner variant="info">{notice}</Banner>
                  </div>
                )}
                {serverError && (
                  <div class="mb-6 overflow-hidden rounded-lg">
                    <Banner variant="error">{serverError}</Banner>
                  </div>
                )}
                <header class="mb-8">
                  <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent sm:text-4xl">
                    {displayNickname}
                  </h1>
                  {isOwnProfile && (
                    <p class="mt-3">
                      <a
                        href="/profile"
                        class="text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline"
                      >
                        Edit your profile
                      </a>
                    </p>
                  )}
                  {friendCta && (
                    <FriendActions
                      client:load
                      targetUserId={profile.id}
                      relationship={friendCta.status}
                      requestId={friendCta.requestId}
                    />
                  )}
                </header>

                <section class="mb-8 rounded-xl border border-white/10 bg-white/5 px-5 py-5 backdrop-blur-xl">
                  <h2 class="mb-4 text-sm font-semibold tracking-wide text-white/80 uppercase">Public profile</h2>
                  <dl class="grid grid-cols-1 gap-3 text-sm sm:grid-cols-2">
                    <div>
                      <dt class="text-blue-100/50">Nickname</dt>
                      <dd class="mt-0.5 text-white">{displayNickname}</dd>
                    </div>
                    <div>
                      <dt class="text-blue-100/50">Verification</dt>
                      <dd class="mt-0.5 text-white">{profile.isVerified ? "Verified" : "Not verified"}</dd>
                    </div>
                    <div>
                      <dt class="text-blue-100/50">KoG points</dt>
                      <dd class="mt-0.5 text-white">{kogPointsLabel}</dd>
                    </div>
                    <div>
                      <dt class="text-blue-100/50">Points source</dt>
                      <dd class="mt-0.5 text-white">
                        {profile.kogPointsVerified ? "Checked in-game" : "Self-reported"}
                      </dd>
                    </div>
                    {labelsError ? (
                      <div class="sm:col-span-2">
                        <dt class="text-blue-100/50">Labels</dt>
                        <dd class="mt-0.5 text-blue-100/60">{labelsError}</dd>
                      </div>
                    ) : labels.length > 0 ? (
                      <div class="sm:col-span-2">
                        <dt class="text-blue-100/50">Labels</dt>
                        <dd class="mt-1 flex flex-wrap gap-1.5">
                          {labels.map((label) => (
                            <PlayerLabelChip name={label.name} color={label.color} description={label.description} />
                          ))}
                        </dd>
                      </div>
                    ) : null}
                  </dl>
                </section>

                <section class="mb-8 rounded-xl border border-white/10 bg-white/5 px-5 py-5 backdrop-blur-xl">
                  <h2 class="mb-4 text-sm font-semibold tracking-wide text-white/80 uppercase">Friends</h2>
                  {friendsError ? (
                    <p class="text-sm text-blue-100/60">{friendsError}</p>
                  ) : friends.length === 0 ? (
                    <p class="text-sm text-blue-100/60">No friends yet</p>
                  ) : (
                    <ul class="flex flex-wrap gap-x-4 gap-y-2">
                      {friends.map((friend) => (
                        <li>
                          <NicknameLink userId={friend.id} nickname={friend.nickname} />
                        </li>
                      ))}
                    </ul>
                  )}
                </section>

                {showOwnerInbox && (
                  <div id="inbox" class="mb-8 scroll-mt-4 space-y-8">
                    {inboxError ? (
                      <p class="rounded-lg border border-red-400/30 bg-red-500/10 px-4 py-3 text-sm text-red-100">
                        {inboxError}
                      </p>
                    ) : (
                      <>
                        <FriendsInbox
                          verified={profile.isVerified}
                          incoming={incomingFriendRequests}
                          outgoing={outgoingFriendRequests}
                          publicProfileHref={null}
                          redirectTo={ownerInboxHref}
                        />
                        <ClanInvitesInbox
                          verified={profile.isVerified}
                          incoming={incomingClanInvites}
                          outgoing={outgoingClanInvites}
                          redirectTo={ownerInboxHref}
                        />
                        <RunInvitesInbox incoming={incomingRunInvites} />
                      </>
                    )}
                  </div>
                )}

                <PlayerProfileRunSections
                  incoming={incomingRuns}
                  recent={recentRuns}
                  loadError={runsError}
                  viewerId={user?.id ?? null}
                  viewerIsAdmin={viewerIsAdmin}
                  viewerConfirmedRunIds={viewerConfirmedRunIds}
                />
              </>
            )
          )
        }
      </RunPreviewShell>
    </div>
  </PageChrome>
</Layout>
