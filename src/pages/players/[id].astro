---
import Layout from "@/layouts/Layout.astro";
import PageChrome from "@/components/PageChrome.astro";
import { createClient } from "@/lib/supabase";
import { getPublicProfile, type PublicProfile } from "@/lib/services/profile";

const { id } = Astro.params;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const { user } = Astro.locals;

let profile: PublicProfile | null = null;
let pageError: "missing" | "config" | "load" | null = null;

if (!id) {
  pageError = "missing";
} else if (!supabase) {
  pageError = "config";
} else {
  try {
    profile = await getPublicProfile(supabase, id);
    if (!profile) {
      pageError = "missing";
    }
  } catch (err) {
    console.error("getPublicProfile failed on public player page", err);
    pageError = "load";
  }
}

if (pageError === "missing") {
  Astro.response.status = 404;
} else if (pageError === "load" || pageError === "config") {
  Astro.response.status = 500;
}

const displayNickname = profile?.nickname ?? "—";
const pageTitle = profile ? `${displayNickname} — Book Your Miggets` : "Player — Book Your Miggets";
const isOwnProfile = Boolean(user?.id && user.id === profile?.id);
const kogPointsLabel = profile && profile.kogPoints !== null ? String(profile.kogPoints) : "—";
---

<Layout title={pageTitle}>
  <PageChrome>
    <p class="mb-6">
      <a href="/runs" class="text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline">
        ← Active runs
      </a>
    </p>

    {
      pageError === "missing" ? (
        <div class="rounded-xl border border-white/10 bg-white/5 px-6 py-12 text-center backdrop-blur-xl">
          <h1 class="text-2xl font-bold text-white">Player not found</h1>
          <p class="mt-2 text-sm text-blue-100/60">This player is missing.</p>
        </div>
      ) : pageError ? (
        <div class="rounded-xl border border-red-400/30 bg-red-500/10 px-6 py-12 text-center">
          <h1 class="text-2xl font-bold text-white">Could not load player</h1>
          <p class="mt-2 text-sm text-red-100/80">
            {pageError === "config" ? "Supabase is not configured." : "Please try again later."}
          </p>
        </div>
      ) : (
        profile && (
          <>
            <header class="mb-8">
              <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent sm:text-4xl">
                {displayNickname}
              </h1>
              {isOwnProfile && (
                <p class="mt-3">
                  <a
                    href="/profile"
                    class="text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline"
                  >
                    Edit your profile
                  </a>
                </p>
              )}
            </header>

            <section class="mb-8 rounded-xl border border-white/10 bg-white/5 px-5 py-5 backdrop-blur-xl">
              <h2 class="mb-4 text-sm font-semibold tracking-wide text-white/80 uppercase">Public profile</h2>
              <dl class="grid grid-cols-1 gap-3 text-sm sm:grid-cols-2">
                <div>
                  <dt class="text-blue-100/50">Nickname</dt>
                  <dd class="mt-0.5 text-white">{displayNickname}</dd>
                </div>
                <div>
                  <dt class="text-blue-100/50">Verification</dt>
                  <dd class="mt-0.5 text-white">{profile.isVerified ? "Verified" : "Not verified"}</dd>
                </div>
                <div>
                  <dt class="text-blue-100/50">KoG points</dt>
                  <dd class="mt-0.5 text-white">{kogPointsLabel}</dd>
                </div>
                <div>
                  <dt class="text-blue-100/50">Points source</dt>
                  <dd class="mt-0.5 text-white">{profile.kogPointsVerified ? "Checked in-game" : "Self-reported"}</dd>
                </div>
              </dl>
            </section>
          </>
        )
      )
    }
  </PageChrome>
</Layout>
