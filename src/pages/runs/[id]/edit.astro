---
import Layout from "@/layouts/Layout.astro";
import PageChrome from "@/components/PageChrome.astro";
import CreateRunForm from "@/components/runs/CreateRunForm";
import { createClient } from "@/lib/supabase";
import { listPublicFriends, type PublicFriend } from "@/lib/services/friends";
import { countConfirmedParticipants } from "@/lib/services/participants";
import {
  getOwnedActiveRunForEdit,
  isUuid,
  listMapsForPicker,
  listPublicNicknamesByIds,
  listRunInviteeIds,
  type MapPickerItem,
  type RunDetail,
} from "@/lib/services/runs";

const { id } = Astro.params;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const { user } = Astro.locals;
const error = Astro.url.searchParams.get("error");
const isBanned = Boolean(Astro.locals.profile?.isBanned);

let run: RunDetail | null = null;
let maps: MapPickerItem[] = [];
let friends: PublicFriend[] = [];
let inviteeIds: string[] = [];
let confirmedCount = 0;
let joinModeLocked = false;
let pageError: "missing" | "config" | "load" | null = null;

if (!id || !isUuid(id)) {
  pageError = "missing";
} else if (!supabase || !user) {
  pageError = "config";
} else {
  try {
    run = await getOwnedActiveRunForEdit(supabase, id, user.id);
    if (!run) {
      pageError = "missing";
    } else if (!isBanned) {
      const [mapRows, confirmed, others, friendRows, snapshotIds] = await Promise.all([
        listMapsForPicker(supabase),
        countConfirmedParticipants(supabase, run.id),
        supabase
          .from("run_participants")
          .select("id", { count: "exact", head: true })
          .eq("run_id", run.id)
          .neq("user_id", user.id),
        listPublicFriends(supabase, user.id),
        listRunInviteeIds(supabase, run.id),
      ]);
      if (others.error) {
        throw new Error(`Failed to count participants: ${others.error.message}`);
      }
      maps = mapRows;
      confirmedCount = confirmed;
      joinModeLocked = (others.count ?? 0) > 0;
      inviteeIds = snapshotIds;
      const friendIdSet = new Set(friendRows.map((friend) => friend.id));
      const leftoverIds = snapshotIds.filter((id) => !friendIdSet.has(id));
      const leftovers = await listPublicNicknamesByIds(supabase, leftoverIds);
      friends = [...friendRows, ...leftovers];
    }
  } catch {
    pageError = "load";
  }
}

if (pageError === "missing") {
  Astro.response.status = 404;
} else if (pageError === "load" || pageError === "config") {
  Astro.response.status = 500;
}

const pageTitle = run ? `Edit ${run.displayTitle} — Book Your Miggets` : "Edit run — Book Your Miggets";
const backHref = run ? `/runs/${run.id}` : "/runs";
---

<Layout title={pageTitle}>
  <PageChrome contentClass="max-w-xl">
    <p class="mb-6">
      <a href={backHref} class="text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline">
        {run ? "← Back to run" : "← Active runs"}
      </a>
    </p>

    {
      pageError === "missing" ? (
        <div class="rounded-xl border border-white/10 bg-white/5 px-6 py-12 text-center backdrop-blur-xl">
          <h1 class="text-2xl font-bold text-white">Run not found</h1>
          <p class="mt-2 text-sm text-blue-100/60">This run is missing or no longer active.</p>
        </div>
      ) : pageError ? (
        <div class="rounded-xl border border-red-400/30 bg-red-500/10 px-6 py-12 text-center">
          <h1 class="text-2xl font-bold text-white">Could not load run</h1>
          <p class="mt-2 text-sm text-red-100/80">
            {pageError === "config" ? "Supabase is not configured." : "Please try again later."}
          </p>
        </div>
      ) : isBanned ? (
        <>
          <header class="mb-8">
            <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent sm:text-4xl">
              Edit run
            </h1>
          </header>
          <p class="rounded-lg border border-red-400/30 bg-red-500/10 px-4 py-3 text-sm text-red-100">
            Your account is banned — you cannot edit runs.
          </p>
        </>
      ) : (
        run && (
          <>
            <header class="mb-8">
              <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent sm:text-4xl">
                Edit run
              </h1>
              <p class="mt-2 text-sm text-blue-100/60">Update this run. Public list and detail show the new values.</p>
            </header>

            <div class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl">
              <CreateRunForm
                maps={maps}
                nickname={null}
                isVerified={false}
                friends={friends}
                serverError={error}
                edit={{
                  runId: run.id,
                  title: run.title ?? "",
                  mapId: run.map?.id ?? "",
                  mapCategory: run.mapCategory ?? "",
                  startsAt: run.startsAt,
                  maxParticipants: run.maxParticipants,
                  minPoints: run.minPoints,
                  joinMode: run.joinMode,
                  visibility: run.visibility,
                  inviteeIds,
                  confirmedCount,
                  joinModeLocked,
                  extendedUntil: run.extendedUntil,
                }}
                client:load
              />
            </div>
          </>
        )
      )
    }
  </PageChrome>
</Layout>
