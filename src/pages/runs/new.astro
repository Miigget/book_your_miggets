---
import Layout from "@/layouts/Layout.astro";
import PageChrome from "@/components/PageChrome.astro";
import CreateRunForm from "@/components/runs/CreateRunForm";
import { createClient } from "@/lib/supabase";
import { getOwnProfile } from "@/lib/services/profile";
import { userOwnsClan } from "@/lib/services/clans";
import { listPublicFriends, type PublicFriend } from "@/lib/services/friends";
import { MAX_ACTIVE_RUNS_PER_ORGANIZER } from "@/lib/run-lifecycle";
import {
  ACTIVE_RUN_CAP_MESSAGE,
  countAudienceActiveRunsForOrganizer,
  listMapsForPicker,
  type MapPickerItem,
} from "@/lib/services/runs";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const { user } = Astro.locals;
const error = Astro.url.searchParams.get("error");
const isBanned = Boolean(Astro.locals.profile?.isBanned);

let maps: MapPickerItem[] = [];
let nickname: string | null = null;
let isVerified = false;
let friends: PublicFriend[] = [];
let ownsClan = false;
let loadError: string | null = null;
let atActiveCap = false;

if (!supabase || !user) {
  loadError = "Supabase is not configured.";
} else if (!isBanned) {
  try {
    const activeCount = await countAudienceActiveRunsForOrganizer(supabase, user.id);
    atActiveCap = activeCount >= MAX_ACTIVE_RUNS_PER_ORGANIZER;
    if (!atActiveCap) {
      const [mapRows, own] = await Promise.all([listMapsForPicker(supabase), getOwnProfile(supabase, user.id)]);
      maps = mapRows;
      nickname = own.nickname;
      isVerified = own.isVerified;
      if (own.isVerified) {
        const [friendRows, owns] = await Promise.all([
          listPublicFriends(supabase, user.id),
          userOwnsClan(supabase, user.id),
        ]);
        friends = friendRows;
        ownsClan = owns;
      }
    }
  } catch (err) {
    loadError = err instanceof Error ? err.message : "Failed to load create form.";
  }
}
---

<Layout title="Create a run — Book Your Miggets">
  <PageChrome contentClass="max-w-xl">
    <p class="mb-6">
      <a href="/runs" class="text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline">
        ← Active runs
      </a>
    </p>

    <header class="mb-8">
      <h1
        class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent sm:text-4xl"
      >
        Create a run
      </h1>
      <p class="mt-2 text-sm text-blue-100/60">Pick a map (optional), set capacity and start time, publish.</p>
    </header>

    {
      isBanned ? (
        <p class="rounded-lg border border-red-400/30 bg-red-500/10 px-4 py-3 text-sm text-red-100">
          Your account is banned — you cannot create runs.
        </p>
      ) : loadError ? (
        <p class="rounded-lg border border-red-400/30 bg-red-500/10 px-4 py-3 text-sm text-red-100">{loadError}</p>
      ) : atActiveCap ? (
        <p class="rounded-lg border border-amber-400/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-100">
          {error ?? ACTIVE_RUN_CAP_MESSAGE}
        </p>
      ) : (
        <div class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl">
          <CreateRunForm
            maps={maps}
            nickname={nickname}
            isVerified={isVerified}
            friends={friends}
            ownsClan={ownsClan}
            serverError={error}
            client:load
          />
        </div>
      )
    }
  </PageChrome>
</Layout>
