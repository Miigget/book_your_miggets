---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import AdminRunControls from "@/components/runs/AdminRunControls";
import RunParticipantActions from "@/components/runs/RunParticipantActions";
import { formatStart } from "@/lib/format-date";
import { createClient } from "@/lib/supabase";
import {
  getOwnParticipation,
  listConfirmedParticipants,
  listDeniedParticipants,
  listPendingParticipants,
  type ConfirmedParticipant,
  type OwnParticipation,
  type PendingParticipant,
} from "@/lib/services/participants";
import { formatJoinMode, getActiveRunById, getOwnNickname, type RunDetail } from "@/lib/services/runs";

const { id } = Astro.params;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const { user } = Astro.locals;
const serverError = Astro.url.searchParams.get("error");

let run: RunDetail | null = null;
let pageError: "missing" | "config" | "load" | null = null;
let confirmed: ConfirmedParticipant[] = [];
let pending: PendingParticipant[] = [];
let denied: PendingParticipant[] = [];
let own: OwnParticipation | null = null;
let nickname: string | null = null;

if (!id) {
  pageError = "missing";
} else if (!supabase) {
  pageError = "config";
} else {
  try {
    run = await getActiveRunById(supabase, id);
    if (!run) {
      pageError = "missing";
    } else {
      confirmed = await listConfirmedParticipants(supabase, run.id);
      if (user) {
        const isOrganizer = user.id === run.organizerId;
        [own, nickname] = await Promise.all([
          getOwnParticipation(supabase, run.id, user.id),
          getOwnNickname(supabase, user.id),
        ]);
        if (isOrganizer) {
          [pending, denied] = await Promise.all([
            listPendingParticipants(supabase, run.id),
            listDeniedParticipants(supabase, run.id),
          ]);
        }
      }
    }
  } catch {
    pageError = "load";
  }
}

if (pageError === "missing") {
  Astro.response.status = 404;
} else if (pageError === "load" || pageError === "config") {
  Astro.response.status = 500;
}

const pageTitle = run ? `${run.displayTitle} — Book Your Miggets` : "Run — Book Your Miggets";
const isBanned = Boolean(Astro.locals.profile?.isBanned);
const isAdmin = Astro.locals.profile?.role === "admin";
const isOrganizer = Boolean(user?.id && user.id === run?.organizerId);
const organizerSeated = isOrganizer && confirmed.some((p) => p.userId === user?.id);
const confirmedCount = confirmed.length;

function formatReleasedOn(value: string | null): string {
  if (!value) return "Unknown";
  return value;
}
---

<Layout title={pageTitle}>
  <div class="bg-cosmic relative min-h-screen w-full overflow-hidden">
    <div
      class="pointer-events-none absolute top-1/4 -left-24 h-[350px] w-[350px] rounded-full bg-purple-500/20 blur-[120px]"
    >
    </div>
    <div
      class="pointer-events-none absolute top-2/3 -right-16 h-[250px] w-[250px] rounded-full bg-blue-500/15 blur-[100px]"
    >
    </div>

    <div class="relative z-10 mx-auto max-w-3xl p-4 sm:p-8">
      <Topbar />

      <p class="mb-6">
        <a href="/runs" class="text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline">
          ← Active runs
        </a>
      </p>

      {
        pageError === "missing" ? (
          <div class="rounded-xl border border-white/10 bg-white/5 px-6 py-12 text-center backdrop-blur-xl">
            <h1 class="text-2xl font-bold text-white">Run not found</h1>
            <p class="mt-2 text-sm text-blue-100/60">This run is missing or no longer active.</p>
          </div>
        ) : pageError ? (
          <div class="rounded-xl border border-red-400/30 bg-red-500/10 px-6 py-12 text-center">
            <h1 class="text-2xl font-bold text-white">Could not load run</h1>
            <p class="mt-2 text-sm text-red-100/80">
              {pageError === "config" ? "Supabase is not configured." : "Please try again later."}
            </p>
          </div>
        ) : (
          run && (
            <>
              <header class="mb-8">
                <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent sm:text-4xl">
                  {run.displayTitle}
                </h1>
                {run.lifecyclePhase === "in_progress" && (
                  <p class="mt-2 text-sm text-blue-100/80">
                    Status: <span class="text-amber-200">In progress / already started</span>
                  </p>
                )}
                {run.organizerNickname && (
                  <p class="mt-2 text-sm text-blue-100/60">
                    Organized by <span class="text-blue-100/90">{run.organizerNickname}</span>
                  </p>
                )}
              </header>

              <section class="mb-8 rounded-xl border border-white/10 bg-white/5 px-5 py-5 backdrop-blur-xl">
                <h2 class="mb-4 text-sm font-semibold tracking-wide text-white/80 uppercase">Run details</h2>
                <dl class="grid grid-cols-1 gap-3 text-sm sm:grid-cols-2">
                  <div>
                    <dt class="text-blue-100/50">Starts</dt>
                    <dd class="mt-0.5 text-white">
                      <time datetime={run.startsAt}>{formatStart(run.startsAt)}</time>
                    </dd>
                  </div>
                  <div>
                    <dt class="text-blue-100/50">Capacity</dt>
                    <dd class="mt-0.5 text-white">
                      {confirmedCount}/{run.maxParticipants}
                    </dd>
                  </div>
                  <div>
                    <dt class="text-blue-100/50">Min points</dt>
                    <dd class="mt-0.5 text-white">{run.minPoints}</dd>
                  </div>
                  <div>
                    <dt class="text-blue-100/50">Join mode</dt>
                    <dd class="mt-0.5 text-white">{formatJoinMode(run.joinMode)}</dd>
                  </div>
                </dl>
              </section>

              {run.map && (
                <section class="mb-8 rounded-xl border border-white/10 bg-white/5 px-5 py-5 backdrop-blur-xl">
                  <h2 class="mb-4 text-sm font-semibold tracking-wide text-white/80 uppercase">Map</h2>
                  <dl class="grid grid-cols-1 gap-3 text-sm sm:grid-cols-2">
                    <div>
                      <dt class="text-blue-100/50">Name</dt>
                      <dd class="mt-0.5 text-white">{run.map.name}</dd>
                    </div>
                    <div>
                      <dt class="text-blue-100/50">Difficulty</dt>
                      <dd class="mt-0.5 text-white">{run.map.difficulty}</dd>
                    </div>
                    <div>
                      <dt class="text-blue-100/50">Stars</dt>
                      <dd class="mt-0.5 text-white">{run.map.stars}</dd>
                    </div>
                    <div>
                      <dt class="text-blue-100/50">Points</dt>
                      <dd class="mt-0.5 text-white">{run.map.points}</dd>
                    </div>
                    <div>
                      <dt class="text-blue-100/50">Length</dt>
                      <dd class="mt-0.5 text-white">{run.map.length ?? "—"}</dd>
                    </div>
                    <div>
                      <dt class="text-blue-100/50">Creator</dt>
                      <dd class="mt-0.5 text-white">{run.map.creator}</dd>
                    </div>
                    <div>
                      <dt class="text-blue-100/50">Released</dt>
                      <dd class="mt-0.5 text-white">{formatReleasedOn(run.map.released_on)}</dd>
                    </div>
                  </dl>
                </section>
              )}

              <section class="mb-8 rounded-xl border border-white/10 bg-white/5 px-5 py-5 backdrop-blur-xl">
                <h2 class="mb-4 text-sm font-semibold tracking-wide text-white/80 uppercase">
                  Participants ({confirmedCount}/{run.maxParticipants})
                </h2>

                {confirmed.length === 0 ? (
                  <p class="mb-5 text-sm text-blue-100/60">No confirmed players yet.</p>
                ) : (
                  <ul class="mb-5 space-y-2">
                    {confirmed.map((participant) => (
                      <li class="text-sm text-white">
                        {participant.nickname ?? "Unknown player"}
                        {run.organizerId === participant.userId && (
                          <span class="ml-2 text-xs text-blue-100/50">(organizer)</span>
                        )}
                      </li>
                    ))}
                  </ul>
                )}

                <RunParticipantActions
                  client:load
                  runId={run.id}
                  joinMode={run.joinMode}
                  maxParticipants={run.maxParticipants}
                  confirmedCount={confirmedCount}
                  isGuest={!user}
                  isBanned={isBanned}
                  isOrganizer={isOrganizer}
                  nickname={nickname}
                  ownStatus={own?.status ?? null}
                  organizerSeated={organizerSeated}
                  pending={pending.map((p) => ({ id: p.id, nickname: p.nickname }))}
                  denied={denied.map((p) => ({ id: p.id, nickname: p.nickname }))}
                  serverError={serverError}
                />
              </section>

              {isAdmin && (
                <section class="mb-8 rounded-xl border border-red-400/20 bg-red-500/5 px-5 py-5 backdrop-blur-xl">
                  <AdminRunControls client:load runId={run.id} />
                </section>
              )}
            </>
          )
        )
      }
    </div>
  </div>
</Layout>
