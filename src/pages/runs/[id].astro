---
import Layout from "@/layouts/Layout.astro";
import Banner from "@/components/Banner.astro";
import NicknameLink from "@/components/NicknameLink.astro";
import PageChrome from "@/components/PageChrome.astro";
import AdminRunControls from "@/components/runs/AdminRunControls";
import OrganizerRunLifecycleControls from "@/components/runs/OrganizerRunLifecycleControls";
import RunComments from "@/components/runs/RunComments";
import RunParticipantActions from "@/components/runs/RunParticipantActions";
import { formatStart } from "@/lib/format-date";
import type { ActiveRunLifecyclePhase } from "@/lib/run-lifecycle";
import { createClient } from "@/lib/supabase";
import { userOwnsClan } from "@/lib/services/clans";
import { listCommentsForRun, type RunComment } from "@/lib/services/comments";
import {
  getOwnParticipation,
  listConfirmedParticipants,
  listDeniedParticipants,
  listPendingParticipants,
  type ConfirmedParticipant,
  type OwnParticipation,
  type PendingParticipant,
} from "@/lib/services/participants";
import { getOwnProfile } from "@/lib/services/profile";
import {
  formatJoinMode,
  formatVisibility,
  getActiveRunById,
  getArchivedRunForAdmin,
  getArchivedRunForOrganizer,
  getArchivedRunForParticipant,
  type ArchivedRunDetail,
  type RunDetail,
} from "@/lib/services/runs";

const { id } = Astro.params;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const { user } = Astro.locals;
const isAdmin = Astro.locals.profile?.role === "admin";
const serverError = Astro.url.searchParams.get("error");
const commentError = Astro.url.searchParams.get("commentError");

let run: RunDetail | ArchivedRunDetail | null = null;
let pageError: "missing" | "config" | "load" | null = null;
let archivedSource: "participant" | "organizer" | "admin" | null = null;
let confirmed: ConfirmedParticipant[] = [];
let pending: PendingParticipant[] = [];
let denied: PendingParticipant[] = [];
let own: OwnParticipation | null = null;
let nickname: string | null = null;
let isVerified = false;
let comments: RunComment[] = [];
let canReadComments = false;
let ownsClan = false;

if (!id) {
  pageError = "missing";
} else if (!supabase) {
  pageError = "config";
} else {
  try {
    run = await getActiveRunById(supabase, id);
    if (!run && user) {
      run = await getArchivedRunForParticipant(supabase, id, user.id);
      if (run) archivedSource = "participant";
    }
    if (!run && user) {
      run = await getArchivedRunForOrganizer(supabase, id, user.id);
      if (run) archivedSource = "organizer";
    }
    if (!run && isAdmin) {
      run = await getArchivedRunForAdmin(supabase, id);
      if (run) archivedSource = "admin";
    }
    if (!run) {
      pageError = "missing";
    } else {
      confirmed = await listConfirmedParticipants(supabase, run.id);
      const archived = run.lifecyclePhase === "archived";
      if (user && !archived) {
        const isOrganizer = user.id === run.organizerId;
        const [ownRow, ownProfile] = await Promise.all([
          getOwnParticipation(supabase, run.id, user.id),
          getOwnProfile(supabase, user.id),
        ]);
        own = ownRow;
        nickname = ownProfile.nickname;
        isVerified = ownProfile.isVerified;
        if (isOrganizer) {
          const [pendingRows, deniedRows, owns] = await Promise.all([
            listPendingParticipants(supabase, run.id),
            listDeniedParticipants(supabase, run.id),
            userOwnsClan(supabase, user.id),
          ]);
          pending = pendingRows;
          denied = deniedRows;
          ownsClan = owns;
        }
      }
      canReadComments =
        own?.status === "confirmed" || archivedSource === "participant" || user?.id === run.organizerId || isAdmin;
      if (canReadComments) {
        comments = await listCommentsForRun(supabase, run.id, user?.id ?? null);
      }
    }
  } catch {
    pageError = "load";
  }
}

if (pageError === "missing") {
  Astro.response.status = 404;
} else if (pageError === "load" || pageError === "config") {
  Astro.response.status = 500;
}

const pageTitle = run ? `${run.displayTitle} — Book Your Miggets` : "Run — Book Your Miggets";
const isArchived = run?.lifecyclePhase === "archived";
const isBanned = Boolean(Astro.locals.profile?.isBanned);
const canPostOrLike = own?.status === "confirmed" && !isArchived && !isBanned;
const isOrganizer = Boolean(user?.id && user.id === run?.organizerId);
const isCompleted = Boolean(run?.completedAt);
const isVerifiedFinish = Boolean(run?.verifiedAt);
const hideInProgressChip = isCompleted || isVerifiedFinish;
const showCompletedChip = isCompleted && !isVerifiedFinish && run?.lifecyclePhase !== "archived";
const showVerifiedFinishChip = isVerifiedFinish;
const showVerifyFinish = run?.visibility === "clan_only" && isCompleted && !isVerifiedFinish && run.map != null;
const showComplete =
  run != null &&
  isOrganizer &&
  run.visibility === "clan_only" &&
  run.lifecyclePhase === "in_progress" &&
  !isCompleted &&
  ownsClan &&
  !isArchived;
const confirmedCount = confirmed.length;
const archivedBackHref = archivedSource === "admin" ? "/admin" : "/dashboard?tab=past";
const archivedBackLabel = archivedSource === "admin" ? "← Admin" : "← Dashboard";
const organizerLifecyclePhase: ActiveRunLifecyclePhase =
  run && run.lifecyclePhase !== "archived" ? run.lifecyclePhase : "upcoming";

function formatReleasedOn(value: string | null): string {
  if (!value) return "Unknown";
  return value;
}
---

<Layout title={pageTitle}>
  <PageChrome>
    <p class="mb-6">
      <a
        href={isArchived ? archivedBackHref : "/runs"}
        class="text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline"
      >
        {isArchived ? archivedBackLabel : "← Active runs"}
      </a>
    </p>

    {
      pageError === "missing" ? (
        <div class="rounded-xl border border-white/10 bg-white/5 px-6 py-12 text-center backdrop-blur-xl">
          <h1 class="text-2xl font-bold text-white">Run not found</h1>
          <p class="mt-2 text-sm text-blue-100/60">This run is missing or no longer active.</p>
        </div>
      ) : pageError ? (
        <div class="rounded-xl border border-red-400/30 bg-red-500/10 px-6 py-12 text-center">
          <h1 class="text-2xl font-bold text-white">Could not load run</h1>
          <p class="mt-2 text-sm text-red-100/80">
            {pageError === "config" ? "Supabase is not configured." : "Please try again later."}
          </p>
        </div>
      ) : (
        run && (
          <>
            <header class="mb-8">
              <h1 class="min-w-0 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold break-all text-transparent sm:text-4xl">
                {run.displayTitle}
              </h1>
              {showCompletedChip && (
                <p class="mt-2 text-sm text-blue-100/80">
                  Status: <span class="text-emerald-200">Completed</span>
                </p>
              )}
              {showVerifiedFinishChip && (
                <p class="mt-2 text-sm text-blue-100/80">
                  Status: <span class="text-emerald-200">Verified-finish</span>
                </p>
              )}
              {run.lifecyclePhase === "in_progress" && !hideInProgressChip && (
                <p class="mt-2 text-sm text-blue-100/80">
                  Status: <span class="text-amber-200">In progress / already started</span>
                </p>
              )}
              {run.lifecyclePhase === "archived" && (
                <p class="mt-2 text-sm text-blue-100/80">
                  Status: <span class="text-blue-100/90">Archived</span>
                </p>
              )}
              <p class="mt-2 text-sm text-blue-100/60">
                Organized by <NicknameLink userId={run.organizerId} nickname={run.organizerNickname} />
              </p>
              {isOrganizer && !isArchived && (
                <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
                  {!isCompleted && (
                    <a
                      href={`/runs/${run.id}/edit`}
                      class="text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline"
                    >
                      Edit
                    </a>
                  )}
                  <OrganizerRunLifecycleControls
                    client:load
                    runId={run.id}
                    lifecyclePhase={organizerLifecyclePhase}
                    extendedUntil={run.extendedUntil}
                    timeZone={Astro.locals.timeZone}
                    showComplete={showComplete}
                    completedAt={run.completedAt}
                  />
                </div>
              )}
              {(isOrganizer || isAdmin) && serverError && (
                <div class="mt-4 overflow-hidden rounded-lg">
                  <Banner variant="error">{serverError}</Banner>
                </div>
              )}
            </header>

            <section class="mb-8 rounded-xl border border-white/10 bg-white/5 px-5 py-5 backdrop-blur-xl">
              <h2 class="mb-4 text-sm font-semibold tracking-wide text-white/80 uppercase">Run details</h2>
              <dl class="grid grid-cols-1 gap-3 text-sm sm:grid-cols-2">
                <div>
                  <dt class="text-blue-100/50">Starts</dt>
                  <dd class="mt-0.5 text-white">
                    <time datetime={run.startsAt}>{formatStart(run.startsAt, Astro.locals.timeZone)}</time>
                  </dd>
                </div>
                <div>
                  <dt class="text-blue-100/50">Capacity</dt>
                  <dd class="mt-0.5 text-white">
                    {confirmedCount}/{run.maxParticipants}
                  </dd>
                </div>
                <div>
                  <dt class="text-blue-100/50">Min points</dt>
                  <dd class="mt-0.5 text-white">{run.minPoints}</dd>
                </div>
                <div>
                  <dt class="text-blue-100/50">Join mode</dt>
                  <dd class="mt-0.5 text-white">{formatJoinMode(run.joinMode)}</dd>
                </div>
                {run.autoJoinMin != null ? (
                  <div>
                    <dt class="text-blue-100/50">Auto-join first</dt>
                    <dd class="mt-0.5 text-white">{run.autoJoinMin}</dd>
                  </div>
                ) : null}
                <div>
                  <dt class="text-blue-100/50">Visibility</dt>
                  <dd class="mt-0.5 text-white">{formatVisibility(run.visibility)}</dd>
                </div>
                {!run.map && run.mapCategory ? (
                  <div>
                    <dt class="text-blue-100/50">Category</dt>
                    <dd class="mt-0.5 text-white">{run.mapCategory}</dd>
                  </div>
                ) : null}
              </dl>
            </section>

            {run.map ? (
              <section class="mb-8 rounded-xl border border-white/10 bg-white/5 px-5 py-5 backdrop-blur-xl">
                <h2 class="mb-4 text-sm font-semibold tracking-wide text-white/80 uppercase">Map</h2>
                <dl class="grid grid-cols-1 gap-3 text-sm sm:grid-cols-2">
                  <div>
                    <dt class="text-blue-100/50">Name</dt>
                    <dd class="mt-0.5 text-white">{run.map.name}</dd>
                  </div>
                  <div>
                    <dt class="text-blue-100/50">Difficulty</dt>
                    <dd class="mt-0.5 text-white">{run.map.difficulty}</dd>
                  </div>
                  <div>
                    <dt class="text-blue-100/50">Stars</dt>
                    <dd class="mt-0.5 text-white">{run.map.stars}</dd>
                  </div>
                  <div>
                    <dt class="text-blue-100/50">Points</dt>
                    <dd class="mt-0.5 text-white">{run.map.points}</dd>
                  </div>
                  <div>
                    <dt class="text-blue-100/50">Length</dt>
                    <dd class="mt-0.5 text-white">{run.map.length ?? "—"}</dd>
                  </div>
                  <div>
                    <dt class="text-blue-100/50">Creator</dt>
                    <dd class="mt-0.5 text-white">{run.map.creator}</dd>
                  </div>
                  <div>
                    <dt class="text-blue-100/50">Released</dt>
                    <dd class="mt-0.5 text-white">{formatReleasedOn(run.map.released_on)}</dd>
                  </div>
                </dl>
              </section>
            ) : null}

            <section class="mb-8 rounded-xl border border-white/10 bg-white/5 px-5 py-5 backdrop-blur-xl">
              {isArchived ? (
                <>
                  <h2 class="mb-4 text-sm font-semibold tracking-wide text-white/80 uppercase">
                    Participants ({confirmedCount}/{run.maxParticipants})
                  </h2>
                  {confirmed.length === 0 ? (
                    <p class="text-sm text-blue-100/60">No confirmed players yet.</p>
                  ) : (
                    <ul class="space-y-2">
                      {confirmed.map((participant) => (
                        <li class="text-sm text-white">
                          <NicknameLink userId={participant.userId} nickname={participant.nickname} />
                          {run.organizerId === participant.userId && (
                            <span class="ml-2 text-xs text-blue-100/50">(organizer)</span>
                          )}
                        </li>
                      ))}
                    </ul>
                  )}
                </>
              ) : (
                <RunParticipantActions
                  client:load
                  runId={run.id}
                  organizerId={run.organizerId}
                  viewerUserId={user?.id ?? null}
                  joinMode={run.joinMode}
                  autoJoinMin={run.autoJoinMin}
                  maxParticipants={run.maxParticipants}
                  isGuest={!user}
                  isBanned={isBanned}
                  isOrganizer={isOrganizer}
                  nickname={nickname}
                  isVerified={isVerified}
                  ownStatus={own?.status ?? null}
                  confirmed={confirmed.map((p) => ({ id: p.id, userId: p.userId, nickname: p.nickname }))}
                  pending={pending.map((p) => ({ id: p.id, userId: p.userId, nickname: p.nickname }))}
                  denied={denied.map((p) => ({ id: p.id, userId: p.userId, nickname: p.nickname }))}
                  commentsMounted={canReadComments}
                  serverError={serverError}
                  rosterFrozen={isCompleted}
                />
              )}
            </section>

            {canReadComments && (
              <section class="mb-8 rounded-xl border border-white/10 bg-white/5 px-5 py-5 backdrop-blur-xl">
                <h2 class="mb-4 text-sm font-semibold tracking-wide text-white/80 uppercase">Comments</h2>
                <RunComments
                  client:load
                  runId={run.id}
                  comments={comments}
                  canPostOrLike={canPostOrLike}
                  isAdmin={isAdmin}
                  commentError={commentError}
                  timeZone={Astro.locals.timeZone}
                />
              </section>
            )}

            {isAdmin && (
              <section class="mb-8 rounded-xl border border-red-400/20 bg-red-500/5 px-5 py-5 backdrop-blur-xl">
                <AdminRunControls
                  client:load
                  runId={run.id}
                  showArchive={!isArchived}
                  showVerifyFinish={showVerifyFinish}
                />
              </section>
            )}
          </>
        )
      )
    }
  </PageChrome>
</Layout>

<script is:inline>
  (() => {
    const key = "bym:scroll:" + location.pathname;
    const y = sessionStorage.getItem(key);
    if (y == null) return;
    sessionStorage.removeItem(key);
    const top = Number(y);
    if (Number.isFinite(top)) window.scrollTo(0, top);
  })();
</script>
