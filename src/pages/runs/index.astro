---
import Layout from "@/layouts/Layout.astro";
import Banner from "@/components/Banner.astro";
import RunListFilters from "@/components/runs/RunListFilters.astro";
import Topbar from "@/components/Topbar.astro";
import { formatStart } from "@/lib/format-date";
import { hasActiveFilters, parseRunListFilters } from "@/lib/run-list-filters";
import { createClient } from "@/lib/supabase";
import { formatJoinMode, listActiveRuns } from "@/lib/services/runs";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const { user } = Astro.locals;
const notice = Astro.url.searchParams.get("notice");
const serverError = Astro.url.searchParams.get("error");
const filters = parseRunListFilters(Astro.url.searchParams);
const filtersActive = hasActiveFilters(filters);

let runs: Awaited<ReturnType<typeof listActiveRuns>> = [];
let loadError: string | null = null;

if (!supabase) {
  loadError = "Supabase is not configured.";
} else {
  try {
    runs = await listActiveRuns(supabase, filters);
  } catch (err) {
    loadError = err instanceof Error ? err.message : "Failed to load runs.";
  }
}
---

<Layout title="Active runs — Book Your Miggets">
  <div class="bg-cosmic relative min-h-screen w-full overflow-hidden">
    <div
      class="pointer-events-none absolute top-1/4 -left-24 h-[350px] w-[350px] rounded-full bg-purple-500/20 blur-[120px]"
    >
    </div>
    <div
      class="pointer-events-none absolute top-2/3 -right-16 h-[250px] w-[250px] rounded-full bg-blue-500/15 blur-[100px]"
    >
    </div>

    <div class="relative z-10 mx-auto max-w-3xl p-4 sm:p-8">
      <Topbar />

      {
        notice && (
          <div class="mb-6 overflow-hidden rounded-lg">
            <Banner variant="info">{notice}</Banner>
          </div>
        )
      }
      {
        serverError && (
          <div class="mb-6 overflow-hidden rounded-lg">
            <Banner variant="error">{serverError}</Banner>
          </div>
        )
      }

      <header class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h1
            class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent sm:text-4xl"
          >
            Active runs
          </h1>
          <p class="mt-2 text-sm text-blue-100/60">
            Browse active TeeWorlds gores runs (upcoming and in progress). No account needed.
          </p>
        </div>
        {
          user ? (
            <a
              href="/runs/new"
              class="inline-flex items-center justify-center rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
            >
              Create a run
            </a>
          ) : (
            <a
              href="/auth/signin"
              class="inline-flex items-center justify-center rounded-lg border border-white/20 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-white/10"
            >
              Sign in to create
            </a>
          )
        }
      </header>

      <RunListFilters filters={filters} filtersActive={filtersActive} />

      {
        loadError ? (
          <p class="rounded-lg border border-red-400/30 bg-red-500/10 px-4 py-3 text-sm text-red-100">{loadError}</p>
        ) : runs.length === 0 && filtersActive ? (
          <div class="rounded-xl border border-white/10 bg-white/5 px-6 py-12 text-center backdrop-blur-xl">
            <p class="text-lg font-medium text-white">No runs match these filters</p>
            <p class="mt-2 text-sm text-blue-100/60">Clear the filters to see all active runs.</p>
            <a
              href="/runs"
              class="mt-4 inline-flex items-center justify-center rounded-lg border border-white/20 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-white/10"
            >
              Clear
            </a>
          </div>
        ) : runs.length === 0 ? (
          <div class="rounded-xl border border-white/10 bg-white/5 px-6 py-12 text-center backdrop-blur-xl">
            <p class="text-lg font-medium text-white">No active runs yet</p>
            <p class="mt-2 text-sm text-blue-100/60">Check back soon, or create one when you are signed in.</p>
          </div>
        ) : (
          <ul class="flex flex-col gap-3">
            {runs.map((run) => (
              <li>
                <a
                  href={`/runs/${run.id}`}
                  class="block rounded-xl border border-white/10 bg-white/5 px-5 py-4 transition-colors hover:border-white/20 hover:bg-white/10"
                >
                  <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                    <h2 class="text-lg font-semibold text-white">
                      {run.displayTitle}
                      {run.lifecyclePhase === "in_progress" && (
                        <span class="ml-2 text-sm font-medium text-amber-200">In progress</span>
                      )}
                    </h2>
                    <time class="shrink-0 text-sm text-blue-100/70" datetime={run.startsAt}>
                      {formatStart(run.startsAt)}
                    </time>
                  </div>
                  <dl class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-blue-100/60">
                    <div>
                      <dt class="inline">Filled: </dt>
                      <dd class="inline text-blue-100/90">
                        {run.confirmedCount}/{run.maxParticipants}
                      </dd>
                    </div>
                    <div>
                      <dt class="inline">Min points: </dt>
                      <dd class="inline text-blue-100/90">{run.minPoints}</dd>
                    </div>
                    <div>
                      <dt class="inline">Join: </dt>
                      <dd class="inline text-blue-100/90">{formatJoinMode(run.joinMode)}</dd>
                    </div>
                    {run.map && (
                      <div>
                        <dt class="inline">Map: </dt>
                        <dd class="inline text-blue-100/90">
                          {run.map.name}
                          <span class="text-blue-100/50">
                            {" "}
                            · {run.map.difficulty} · {run.map.points} pts
                          </span>
                        </dd>
                      </div>
                    )}
                    {run.organizerNickname && (
                      <div>
                        <dt class="inline">Organizer: </dt>
                        <dd class="inline text-blue-100/90">{run.organizerNickname}</dd>
                      </div>
                    )}
                  </dl>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</Layout>
