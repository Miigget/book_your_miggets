---
import Layout from "@/layouts/Layout.astro";
import PageChrome from "@/components/PageChrome.astro";
import ReleaseEntry from "@/components/changelog/ReleaseEntry.astro";
import { loadChangelogReleases, type ChangelogLoadResult } from "@/lib/services/releases";

const GITHUB_RELEASES_URL = "https://github.com/Miigget/book_your_miggets/releases";

let result: ChangelogLoadResult;
try {
  result = await loadChangelogReleases();
} catch (err) {
  console.error("changelog page loader threw", err);
  result = { ok: false };
}

if (result.ok) {
  Astro.response.headers.set("Cache-Control", "public, max-age=60, s-maxage=3600");
}
---

<Layout title="Changelog — Book Your Miggets">
  <PageChrome>
    <header class="mb-8">
      <h1
        class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent sm:text-4xl"
      >
        Changelog
      </h1>
      <p class="mt-2 text-sm text-blue-100/60">Release notes. No account needed.</p>
    </header>

    {
      !result.ok ? (
        <div>
          <p class="rounded-lg border border-red-400/30 bg-red-500/10 px-4 py-3 text-sm text-red-100">
            Could not load release notes. Try again later.
          </p>
          <p class="mt-3 text-sm text-blue-100/60">
            You can also read notes on{" "}
            <a
              href={GITHUB_RELEASES_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="text-purple-300 transition-colors hover:text-purple-100 hover:underline"
            >
              GitHub Releases
            </a>
            .
          </p>
        </div>
      ) : result.releases.length === 0 ? (
        <div class="rounded-xl border border-white/10 bg-white/5 px-6 py-12 text-center backdrop-blur-xl">
          <p class="text-lg font-medium text-white">No releases yet</p>
          <p class="mt-2 text-sm text-blue-100/60">Notes will appear here after the next tagged release.</p>
        </div>
      ) : (
        <ul class="flex flex-col gap-4">
          {result.releases.map((release) => (
            <li>
              <ReleaseEntry release={release} />
            </li>
          ))}
        </ul>
      )
    }
  </PageChrome>
</Layout>
